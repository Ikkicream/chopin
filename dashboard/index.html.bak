      </div>
      <div class="card">
        <div class="card-title">Prospects CSV</div>
        <div class="card-value" style="margin-top:8px">79 K</div>
        <div class="card-sub">contacts B2B disponibles</div>
      </div>
    </div>
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header"><span class="table-card-title">Contacts récents</span></div>
      <table>
        <thead><tr><th>NOM</th><th>POSTE</th></tr></thead>
        <tbody id="crm-tbody">
          <tr><td colspan="2" style="color:var(--text3)">Chargement...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ═══ RUNS LOGS ═══ -->
  <div id="view-runs" style="display:none">
    <div class="table-card">
      <div class="table-card-header">
        <span class="table-card-title">Historique des runs</span>
        <span id="runs-total-badge" class="tag tag-gray">—</span>
      </div>
      <table>
        <thead><tr><th>DATE</th><th>MODULE</th><th>TÂCHE</th><th>STATUT</th><th>DURÉE</th></tr></thead>
        <tbody id="runs-full-tbody">
          <tr><td colspan="5" style="color:var(--text3)">Chargement...</td></tr>
        </tbody>
      </table>
    </div>
