  <!-- ═══ SERVICES ═══ -->
  <div id="view-services" style="display:none">
    <div class="cards-row cards-3" id="services-kpi-row" style="margin-bottom:14px">
      <div class="card">
        <div class="card-title">Services actifs</div>
        <div class="card-value" id="svc-online" style="margin-top:8px;color:var(--green)">—</div>
