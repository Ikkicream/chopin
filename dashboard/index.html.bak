<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chopin — Genesis Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
  <style>
    /* ═══ shadcn/ui — clean-slate theme (exact) ═══════════════════════ */
    :root {
      --background: rgb(248 248 248);
      --foreground: rgb(29 41 61);
      --card: rgb(255 255 255);
      --card-foreground: rgb(29 41 61);
      --popover: rgb(255 255 255);
      --popover-foreground: rgb(29 41 61);
      --primary: rgb(100 104 240);
      --primary-foreground: rgb(255 255 255);
      --secondary: rgb(228 232 239);
      --secondary-foreground: rgb(54 64 80);
      --muted: rgb(245 245 245);
      --muted-foreground: rgb(108 114 126);
      --accent: rgb(225 231 253);
      --accent-foreground: rgb(54 64 80);
      --destructive: rgb(241 68 68);
      --border: rgb(208 212 219);
      --input: rgb(208 212 219);
      --ring: rgb(100 104 240);
      --chart-1: rgb(100 104 240); --chart-2: rgb(79 70 229);
      --chart-3: rgb(68 59 201);   --chart-4: rgb(55 48 165); --chart-5: rgb(49 45 132);
      --sidebar: rgb(245 245 245);
      --sidebar-foreground: rgb(29 41 61);
      --sidebar-primary: rgb(100 104 240);
      --sidebar-primary-foreground: rgb(255 255 255);
      --sidebar-accent: rgb(225 231 253);
      --sidebar-accent-foreground: rgb(54 64 80);
      --sidebar-border: rgb(208 212 219);
      --sidebar-ring: rgb(100 104 240);
      --font-sans: Inter, system-ui, sans-serif;
      --font-serif: Merriweather, serif;
      --font-mono: 'JetBrains Mono', monospace;
      --radius: 0.5rem;
      --shadow-2xs: 0px 4px 8px -1px rgb(0 0 0 / 0.05);
      --shadow-xs:  0px 4px 8px -1px rgb(0 0 0 / 0.05);
      --shadow-sm:  0px 4px 8px -1px rgb(0 0 0 / 0.10), 0px 1px 2px -2px rgb(0 0 0 / 0.10);
      --shadow:     0px 4px 8px -1px rgb(0 0 0 / 0.10), 0px 1px 2px -2px rgb(0 0 0 / 0.10);
      --shadow-md:  0px 4px 8px -1px rgb(0 0 0 / 0.10), 0px 2px 4px -2px rgb(0 0 0 / 0.10);
      --shadow-lg:  0px 4px 8px -1px rgb(0 0 0 / 0.10), 0px 4px 6px -2px rgb(0 0 0 / 0.10);
      --shadow-xl:  0px 4px 8px -1px rgb(0 0 0 / 0.10), 0px 8px 10px -2px rgb(0 0 0 / 0.10);
      --shadow-2xl: 0px 4px 8px -1px rgb(0 0 0 / 0.25);
      /* legacy colour aliases — used throughout all inline styles */
      --bg: var(--background); --surface: var(--sidebar);
      --border2: rgb(192 197 204); --text: var(--foreground); --text1: var(--foreground);
      --text2: var(--muted-foreground); --text3: rgb(155 162 174);
      --orange: var(--primary); --cyan: rgb(8 145 178); --violet: rgb(124 58 237);
      --green: rgb(22 163 74); --yellow: rgb(180 83 9); --red: var(--destructive); --blue: rgb(37 99 235);
      --glow-o: transparent; --glow-c: transparent;
    }
    .dark {
      --background: rgb(15 24 43);
      --foreground: rgb(227 232 239);
      --card: rgb(29 41 61);
      --card-foreground: rgb(227 232 239);
      --popover: rgb(29 41 61);
      --popover-foreground: rgb(227 232 239);
      --primary: rgb(129 140 249);
      --primary-foreground: rgb(15 24 43);
      --secondary: rgb(47 56 72);
      --secondary-foreground: rgb(208 212 219);
      --muted: rgb(29 41 61);
      --muted-foreground: rgb(155 162 174);
      --accent: rgb(54 64 80);
      --accent-foreground: rgb(208 212 219);
      --destructive: rgb(241 68 68);
      --border: rgb(75 86 102);
      --input: rgb(75 86 102);
      --ring: rgb(129 140 249);
      --chart-1: rgb(129 140 249); --chart-2: rgb(100 104 240);
      --chart-3: rgb(79 70 229);   --chart-4: rgb(68 59 201); --chart-5: rgb(55 48 165);
      --sidebar: rgb(29 41 61);
      --sidebar-foreground: rgb(227 232 239);
      --sidebar-primary: rgb(129 140 249);
      --sidebar-primary-foreground: rgb(15 24 43);
      --sidebar-accent: rgb(54 64 80);
      --sidebar-accent-foreground: rgb(208 212 219);
      --sidebar-border: rgb(75 86 102);
      --sidebar-ring: rgb(129 140 249);
      --shadow-2xs: 0 1px 3px 0px rgb(0 0 0 / 0.05);
      --shadow-xs:  0 1px 3px 0px rgb(0 0 0 / 0.05);
      --shadow-sm:  0 1px 3px 0px rgb(0 0 0 / 0.10), 0 1px 2px -1px rgb(0 0 0 / 0.10);
      --shadow:     0 1px 3px 0px rgb(0 0 0 / 0.10), 0 1px 2px -1px rgb(0 0 0 / 0.10);
      --shadow-md:  0 1px 3px 0px rgb(0 0 0 / 0.10), 0 2px 4px -1px rgb(0 0 0 / 0.10);
      --shadow-lg:  0 1px 3px 0px rgb(0 0 0 / 0.10), 0 4px 6px -1px rgb(0 0 0 / 0.10);
      --shadow-xl:  0 1px 3px 0px rgb(0 0 0 / 0.10), 0 8px 10px -1px rgb(0 0 0 / 0.10);
      --shadow-2xl: 0 1px 3px 0px rgb(0 0 0 / 0.25);
      /* legacy colour aliases */
      --bg: var(--background); --surface: var(--sidebar);
      --border2: rgb(61 79 99); --text: var(--foreground); --text1: var(--foreground);
      --text2: var(--muted-foreground); --text3: rgb(108 114 126);
      --orange: var(--primary); --cyan: rgb(34 211 238); --violet: rgb(167 139 250);
      --green: rgb(74 222 128); --yellow: rgb(250 204 21); --red: var(--destructive); --blue: rgb(96 165 250);
      --glow-o: transparent; --glow-c: transparent;
    }
    @supports (color: rgb(from white r g b)) {
      /* @theme inline block — Tailwind v4 compat, no-op in plain browsers */
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--background);
      color: var(--foreground);
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.5;
      height: 100vh;
      display: grid;
      grid-template-columns: 248px 1fr;
      grid-template-rows: 56px 1fr;
      overflow: hidden;
    }

    /* ── TOPBAR ── */
    #topbar {
      grid-column: 1 / -1;
      background: var(--card);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 14px;
      box-shadow: var(--shadow-sm);
      z-index: 10;
    }
    .logo { font-size: 15px; font-weight: 800; color: var(--primary); letter-spacing: -0.4px; }
    .logo span { color: var(--muted-foreground); font-weight: 400; }
    .topbar-sep { color: var(--border); font-size: 18px; }

    /* ── BADGES / TAGS ── */
    .tag {
      display: inline-flex; align-items: center;
      padding: 2px 10px; border-radius: 99px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.2px; white-space: nowrap;
    }
    /* colors use CSS vars so light/dark mode both look correct */
    .tag-green  { background: color-mix(in srgb, var(--green) 12%, transparent); color: var(--green); border: 1px solid color-mix(in srgb, var(--green) 30%, transparent); }
    .tag-orange { background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary); border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent); }
    .tag-cyan   { background: color-mix(in srgb, var(--cyan) 12%, transparent); color: var(--cyan); border: 1px solid color-mix(in srgb, var(--cyan) 30%, transparent); }
    .tag-red    { background: color-mix(in srgb, var(--destructive) 12%, transparent); color: var(--destructive); border: 1px solid color-mix(in srgb, var(--destructive) 30%, transparent); }
    .tag-gray   { background: var(--secondary); color: var(--muted-foreground); border: 1px solid var(--border); }
    .tag-yellow { background: color-mix(in srgb, var(--yellow) 12%, transparent); color: var(--yellow); border: 1px solid color-mix(in srgb, var(--yellow) 30%, transparent); }
    .tag-violet { background: color-mix(in srgb, var(--violet) 12%, transparent); color: var(--violet); border: 1px solid color-mix(in srgb, var(--violet) 30%, transparent); }

    #clock { margin-left: auto; color: var(--muted-foreground); font-size: 12px; font-family: var(--font-mono); }
    #status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: pulse 2.5s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.8)} }

    /* ── THEME TOGGLE ── */
    .theme-toggle {
      width: 34px; height: 34px; border-radius: var(--radius);
      background: var(--secondary); border: 1px solid var(--border);
      color: var(--muted-foreground); cursor: pointer; font-size: 15px;
      display: flex; align-items: center; justify-content: center;
      transition: background .15s, color .15s; flex-shrink: 0;
    }
    .theme-toggle:hover { background: var(--accent); color: var(--accent-foreground); }

    /* ── SIDEBAR ── */
    #sidebar {
      background: var(--sidebar);
      border-right: 1px solid var(--sidebar-border);
      display: flex; flex-direction: column; gap: 1px;
      padding: 12px 8px;
      overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--sidebar-border) transparent;
    }
    .nav-section {
      padding: 16px 10px 6px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.6px;
      color: var(--muted-foreground); text-transform: uppercase;
    }
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 10px; border-radius: var(--radius);
      cursor: pointer; transition: background .12s, color .12s;
      color: var(--sidebar-foreground); font-size: 13px; font-weight: 500;
      min-height: 38px;
    }
    .nav-item:hover { background: var(--sidebar-accent); color: var(--sidebar-accent-foreground); }
    .nav-item.active { background: var(--sidebar-accent); color: var(--sidebar-primary); font-weight: 600; }
    .nav-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .nav-item .status-badge { margin-left: auto; font-size: 10px; }

    /* ── MAIN ── */
    #main {
      overflow-y: auto; padding: 24px;
      display: flex; flex-direction: column; gap: 16px;
      background: var(--background);
      scrollbar-width: thin; scrollbar-color: var(--border) transparent;
    }

    /* ── CARDS GRID ── */
    .cards-row { display: grid; gap: 16px; }
    .cards-4 { grid-template-columns: repeat(4, 1fr); }
    .cards-3 { grid-template-columns: repeat(3, 1fr); }
    .cards-2 { grid-template-columns: repeat(2, 1fr); }
    .card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 20px 24px;
      box-shadow: var(--shadow-sm);
    }
    .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .card-title {
      font-size: 14px; font-weight: 600;
      color: var(--card-foreground);
      letter-spacing: -0.1px;
    }
    .card-value { font-size: 30px; font-weight: 700; letter-spacing: -0.8px; color: var(--foreground); line-height: 1.1; }
    .card-sub { font-size: 12px; color: var(--muted-foreground); margin-top: 5px; }
    .card-icon { width: 36px; height: 36px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 17px; }

    /* ── CANVAS CARD ── */
    .canvas-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; position: relative; box-shadow: var(--shadow-sm); }
    .canvas-card canvas { display: block; width: 100%; }
    .canvas-overlay { position: absolute; top: 14px; left: 18px; font-size: 12px; font-weight: 600; color: var(--muted-foreground); }

    /* ── TABLE ── */
    .table-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); }
    .table-card-header { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .table-card-title { font-size: 15px; font-weight: 600; color: var(--foreground); letter-spacing: -0.2px; }
    table { width: 100%; border-collapse: collapse; }
    th {
      padding: 10px 16px; font-size: 11px; font-weight: 600;
      letter-spacing: 0.5px; text-transform: uppercase;
      color: var(--muted-foreground); text-align: left;
      border-bottom: 1px solid var(--border);
      background: var(--muted);
    }
    td { padding: 11px 16px; border-bottom: 1px solid var(--border); color: var(--foreground); font-size: 13px; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--muted); }
    .td-mono { font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }

    /* ── PROGRESS BAR ── */
    .progress-wrap { background: var(--secondary); border-radius: 99px; height: 6px; overflow: hidden; }
    .progress-bar { height: 100%; border-radius: 99px; transition: width .5s ease; }

    /* ── CAMPAIGN ── */
    .campaign-item { padding: 12px 0; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; }
    .campaign-item:last-child { border-bottom: none; }
    .campaign-name { flex: 1; color: var(--foreground); font-size: 13px; font-weight: 500; }
    .campaign-stat { text-align: right; min-width: 55px; }
    .campaign-stat .val { font-size: 15px; font-weight: 700; }
    .campaign-stat .lbl { font-size: 10px; color: var(--muted-foreground); }

    /* ── RUN ROW ── */
    .run-module { color: var(--primary); font-weight: 600; }
    .run-ok     { color: var(--green); }
    .run-err    { color: var(--destructive); }
    .run-time   { color: var(--muted-foreground); font-size: 12px; }
    .proc-online  { color: var(--green); font-weight: 600; }
    .proc-stopped { color: var(--muted-foreground); }
    .proc-errored { color: var(--destructive); }

    /* ── KPI ── */
    .kpi-label { font-size: 12px; color: var(--muted-foreground); font-weight: 500; margin-bottom: 4px; }
    .kpi-value { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }

    /* ── SECTION TITLE ── */
    .section-title {
      font-size: 18px; font-weight: 700; letter-spacing: -0.3px;
      color: var(--foreground);
      padding-bottom: 12px; border-bottom: 1px solid var(--border);
      margin-bottom: 4px;
    }

    /* ── SITE COLOR MENU ── */
    .site-menu-btn { background: none; border: none; color: transparent; cursor: pointer; font-size: 14px; padding: 2px 6px; border-radius: calc(var(--radius) - 2px); margin-left: 4px; transition: color .12s, background .12s; line-height: 1; flex-shrink: 0; }
    .nav-site-label:hover .site-menu-btn { color: var(--muted-foreground); }
    .site-menu-btn:hover { color: var(--foreground) !important; background: var(--sidebar-accent); }
    .site-color-popup { position: fixed; z-index: 999; background: var(--popover); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; box-shadow: var(--shadow-lg); display: none; min-width: 168px; }
    .site-color-popup-title { font-size: 10px; color: var(--muted-foreground); font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 10px; }
    .site-color-swatches { display: flex; gap: 8px; flex-wrap: wrap; }
    .swatch { width: 22px; height: 22px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; transition: transform .12s, border-color .12s; flex-shrink: 0; }
    .swatch:hover { transform: scale(1.2); border-color: rgba(255,255,255,.4); }

    /* ── SETUP VIEW ── */
    .setup-section { margin-bottom: 16px; }
    .setup-label { font-size: 10px; font-weight: 600; letter-spacing: 0.4px; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px; }
    .objectives-area { width: 100%; min-height: 120px; resize: vertical; background: var(--background); border: 1px solid var(--input); color: var(--foreground); border-radius: calc(var(--radius) - 2px); padding: 10px 12px; font-size: 13px; font-family: 'Inter', sans-serif; outline: none; box-sizing: border-box; line-height: 1.5; transition: border-color .15s, box-shadow .15s; }
    .objectives-area:focus { border-color: var(--ring); box-shadow: 0 0 0 2px rgba(129,140,249,.2); }
    .connector-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); }
    .connector-row:last-child { border-bottom: none; }
    .connector-name { color: var(--foreground); font-size: 12px; flex: 1; font-weight: 500; }

    /* ── MODULE CARDS ── */
    .module-grid { display: flex; flex-direction: column; gap: 8px; padding: 14px 18px; }
    .module-card { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: calc(var(--radius) - 2px); border: 1px solid var(--border); background: var(--muted); transition: opacity .2s; }
    .module-card.unavailable { opacity: .45; filter: grayscale(.4); }
    .module-card-left { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
    .module-card-name { font-size: 12px; font-weight: 600; }
    .module-card-desc { font-size: 11px; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .module-card-reqs { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 3px; }
    .req-chip { font-size: 9px; padding: 2px 7px; border-radius: 99px; border: 1px solid; font-weight: 600; }
    .req-chip.ok  { border-color: color-mix(in srgb, var(--green) 35%, transparent); color: var(--green); background: color-mix(in srgb, var(--green) 10%, transparent); }
    .req-chip.nok { border-color: rgba(241,68,68,.35); color: var(--destructive); background: rgba(241,68,68,.08); }
    .module-card-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .module-schedule { font-size: 10px; color: var(--muted-foreground); white-space: nowrap; }
    .btn-configure { font-size: 10px; padding: 4px 10px; border-radius: calc(var(--radius) - 2px); cursor: pointer; font-family: 'Inter', sans-serif; font-weight: 600; white-space: nowrap; border: 1px solid rgba(241,68,68,.35); background: rgba(241,68,68,.08); color: var(--destructive); transition: background .12s; }
    .btn-configure:hover { background: rgba(241,68,68,.18); }

    /* ── INDEXATION ── */
    .idx-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; margin-right: 4px; }
    .budget-ring { display: flex; align-items: center; gap: 16px; }

    /* ── SIDEBAR SITE STRUCTURE ── */
    .nav-site-label { display: flex; align-items: center; gap: 8px; padding: 10px 10px 6px; margin-top: 8px; border-left: 3px solid transparent; cursor: pointer; user-select: none; }
    .nav-site-label .site-name { font-size: 11px; font-weight: 700; letter-spacing: 0.3px; }
    .nav-site-label .site-domain { font-size: 10px; color: var(--muted-foreground); }
    .nav-site-chevron { font-size: 9px; color: var(--muted-foreground); transition: transform .22s ease; flex-shrink: 0; line-height: 1; }
    .nav-site-label.nav-collapsed .nav-site-chevron { transform: rotate(-90deg); }
    .nav-children { overflow: hidden; max-height: 600px; opacity: 1; transition: max-height .28s ease, opacity .2s ease; }
    .nav-children.nav-collapsed {
      max-height: 0 !important; opacity: 0;
      pointer-events: none;
    }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    .nav-children:not(.nav-collapsed) .nav-child { animation: fadeUp .18s ease both; }
    .nav-children:not(.nav-collapsed) .nav-child:nth-child(1) { animation-delay: .02s; }
    .nav-children:not(.nav-collapsed) .nav-child:nth-child(2) { animation-delay: .04s; }
    .nav-children:not(.nav-collapsed) .nav-child:nth-child(3) { animation-delay: .06s; }
    .nav-children:not(.nav-collapsed) .nav-child:nth-child(4) { animation-delay: .08s; }
    .nav-children:not(.nav-collapsed) .nav-child:nth-child(5) { animation-delay: .10s; }
    .nav-children:not(.nav-collapsed) .nav-child:nth-child(6) { animation-delay: .12s; }
    .nav-children:not(.nav-collapsed) .nav-child:nth-child(7) { animation-delay: .14s; }
    .nav-child { display: flex; align-items: center; gap: 8px; padding: 6px 10px 6px 26px; font-size: 12px; font-weight: 500; color: var(--muted-foreground); cursor: pointer; border-radius: calc(var(--radius) - 2px); transition: background .12s, color .12s; }
    .nav-child:hover { background: var(--sidebar-accent); color: var(--foreground); }
    .nav-child.active { color: var(--primary); background: rgba(129,140,249,.12); font-weight: 600; }

    /* ── TOOLTIP ── */
    [title] { cursor: help; }

    /* ── LOADING ── */
    #loading-overlay { position: fixed; inset: 0; background: var(--background); display: flex; align-items: center; justify-content: center; z-index: 99; flex-direction: column; gap: 14px; }
    .spinner { width: 32px; height: 32px; border: 2px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin .7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #loading-overlay.hidden { display: none; }

    /* ── WIZARD ── */
    .wizard-steps { display:flex; gap:0; margin-bottom:20px; align-items:center }
    .wizard-step-dot { width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; cursor:pointer; background:var(--secondary); border:1px solid var(--border); color:var(--muted-foreground) }
    .wizard-step-dot.active { background:var(--primary); border-color:var(--primary); color:var(--primary-foreground) }
    .wizard-step-dot.done { background:color-mix(in srgb,var(--green) 15%,transparent); border-color:color-mix(in srgb,var(--green) 40%,transparent); color:var(--green) }
    .wizard-connector { flex:1; height:1px; background:var(--border); margin:0 4px }
    .wizard-field { margin-bottom:14px }
    .wizard-field label { display:block; font-size:10px; font-weight:600; color:var(--muted-foreground); margin-bottom:5px; letter-spacing:.3px; text-transform:uppercase }
    .wizard-field input, .wizard-field textarea, .wizard-field select { width:100%; background:var(--background); border:1px solid var(--input); color:var(--foreground); border-radius:calc(var(--radius) - 2px); padding:9px 12px; font-size:13px; font-family:'Inter',sans-serif; box-sizing:border-box; outline:none; transition:border-color .15s, box-shadow .15s }
    .wizard-field input:focus, .wizard-field textarea:focus, .wizard-field select:focus { border-color:var(--ring); box-shadow:0 0 0 2px rgba(129,140,249,.2) }
    .wizard-field textarea { resize:vertical; min-height:70px }
    .wizard-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px }
    .wizard-grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px }
    .cms-toggle { display:flex; gap:8px }
    .cms-btn { flex:1; padding:9px; text-align:center; border-radius:calc(var(--radius) - 2px); cursor:pointer; font-size:12px; font-weight:500; border:1px solid var(--border); color:var(--muted-foreground); background:var(--secondary) }
    .cms-btn.selected { border-color:var(--primary); background:rgba(129,140,249,.12); color:var(--primary) }
    .rss-row { display:flex; gap:8px; margin-bottom:6px }
    .rss-row input { flex:1 }

</style>
</head>
<body>

<!-- LOADING -->
<div id="loading-overlay">
  <div class="spinner"></div>
  <div style="color:var(--text2);font-size:11px;letter-spacing:1px;">CONNEXION AU SWARM...</div>
</div>

<!-- TOPBAR -->
<header id="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <img src="/assets/ed-cowboy.gif" alt="" style="width:32px;height:32px;border-radius:4px;border:1px solid var(--border);object-fit:cover;padding:0" onerror="this.style.display='none'">
    <div class="logo">CHOPIN <span>/ Genesis</span></div>
  </div>
  <div class="topbar-sep">|</div>
  <div id="system-status" class="tag tag-gray">...</div>
  <div class="topbar-sep">|</div>
  <span style="color:var(--text2)">LCR</span>
  <div id="lcr-badge" class="tag tag-gray">...</div>
  <span style="color:var(--text2)">MKD</span>
  <div id="mkd-badge" class="tag tag-gray">...</div>
  <div id="topbar-site-ctx" style="display:none;padding:2px 10px;border-radius:4px;font-size:10px;letter-spacing:.5px;font-weight:700"></div>
  <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
    <div id="status-dot"></div>
    <span id="clock">--:--:-- UTC</span>
    <button class="theme-toggle" id="theme-toggle-btn" onclick="toggleTheme()" title="Basculer thème clair/sombre">🌙</button>
  </div>
</header>

<!-- SIDEBAR -->
<nav id="sidebar">

  <!-- GENESIS -->
  <div class="nav-section">Genesis</div>
  <div class="nav-item active" onclick="showSiteView('','overview')">
    <div class="nav-dot" style="background:var(--orange)"></div>
    Vue globale
  </div>

  <!-- LCR -->
  <div class="nav-site-label" id="site-label-lcr" style="border-left-color:var(--cyan)" onclick="toggleSiteNav('lcr',event)">
    <div class="nav-dot" id="site-dot-lcr" style="background:var(--cyan);flex-shrink:0"></div>
    <div>
      <div class="site-name" id="site-name-lcr" style="color:var(--cyan)">LCR</div>
      <div class="site-domain">leclientroi.com</div>
    </div>
    <span class="tag tag-cyan" id="nav-articles-count" style="margin-left:auto;font-size:9px">-</span>
    <span class="nav-site-chevron">▾</span>
    <button class="site-menu-btn" onclick="openColorMenu('lcr',event)" title="Changer couleur">···</button>
  </div>
  <div class="nav-children" id="nav-children-lcr">
    <div class="nav-child" data-site="lcr" data-view="dashboard-lcr" onclick="showSiteView('lcr','dashboard-lcr')">
      <div class="nav-dot" style="background:var(--blue);width:4px;height:4px"></div>
      Dashboard
    </div>
    <div class="nav-child" data-site="lcr" data-view="site-lcr" onclick="showSiteView('lcr','site-lcr')">
      <div class="nav-dot" style="background:var(--text3);width:4px;height:4px"></div>
      Setup &amp; Objectifs
    </div>
    <div class="nav-child" data-site="lcr" data-view="articles" onclick="showSiteView('lcr','articles')">
      <div class="nav-dot" style="background:var(--violet);width:4px;height:4px"></div>
      Articles publiés
    </div>
    <div class="nav-child" data-site="lcr" data-view="seo" onclick="showSiteView('lcr','seo')">
      <div class="nav-dot" style="background:var(--green);width:4px;height:4px"></div>
      Analyse SEO
    </div>
    <div class="nav-child" data-site="lcr" data-view="budget" onclick="showSiteView('lcr','budget')">
      <div class="nav-dot" style="background:var(--yellow);width:4px;height:4px"></div>
      Budget API
    </div>
    <div class="nav-child" data-site="lcr" data-view="indexation" onclick="showSiteView('lcr','indexation')">
      <div class="nav-dot" style="background:var(--orange);width:4px;height:4px"></div>
      Indexation
    </div>
    <div class="nav-child" data-site="lcr" data-view="campaigns" onclick="showSiteView('lcr','campaigns')">
      <div class="nav-dot" style="background:var(--cyan);width:4px;height:4px"></div>
      Campagnes Emelia
      <span class="status-badge tag tag-cyan" id="nav-campaigns-count" style="font-size:9px">-</span>
    </div>
  </div>

  <!-- MKD -->
  <div class="nav-site-label" id="site-label-mkd" style="border-left-color:var(--green);margin-top:6px" onclick="toggleSiteNav('mkd',event)">
    <div class="nav-dot" id="site-dot-mkd" style="background:var(--green);flex-shrink:0"></div>
    <div>
      <div class="site-name" id="site-name-mkd" style="color:var(--green)">MKD</div>
      <div class="site-domain">mkdgroupe.com</div>
    </div>
    <span class="nav-site-chevron" style="margin-left:auto">▾</span>
    <button class="site-menu-btn" onclick="openColorMenu('mkd',event)" title="Changer couleur">···</button>
  </div>
  <div class="nav-children" id="nav-children-mkd">
    <div class="nav-child" data-site="mkd" data-view="dashboard-mkd" onclick="showSiteView('mkd','dashboard-mkd')">
      <div class="nav-dot" style="background:var(--blue);width:4px;height:4px"></div>
      Dashboard
    </div>
    <div class="nav-child" data-site="mkd" data-view="site-mkd" onclick="showSiteView('mkd','site-mkd')">
      <div class="nav-dot" style="background:var(--text3);width:4px;height:4px"></div>
      Setup &amp; Objectifs
    </div>
    <div class="nav-child" data-site="mkd" data-view="articles" onclick="showSiteView('mkd','articles')">
      <div class="nav-dot" style="background:var(--violet);width:4px;height:4px"></div>
      Articles publiés
    </div>
    <div class="nav-child" data-site="mkd" data-view="seo" onclick="showSiteView('mkd','seo')">
      <div class="nav-dot" style="background:var(--green);width:4px;height:4px"></div>
      Analyse SEO
    </div>
    <div class="nav-child" data-site="mkd" data-view="budget" onclick="showSiteView('mkd','budget')">
      <div class="nav-dot" style="background:var(--yellow);width:4px;height:4px"></div>
      Budget API
    </div>
    <div class="nav-child" data-site="mkd" data-view="crm" onclick="showSiteView('mkd','crm')">
      <div class="nav-dot" style="background:var(--green);width:4px;height:4px"></div>
      CRM Twenty
      <span class="status-badge tag tag-green" id="nav-crm-count" style="font-size:9px">-</span>
    </div>
  </div>

  <!-- SYSTÈME -->
  <div class="nav-section" style="margin-top:10px">Système</div>
  <div class="nav-item" onclick="showSiteView('','services')">
    <div class="nav-dot" style="background:var(--blue)"></div>
    Services &amp; Crons
    <span class="status-badge tag tag-gray" id="nav-services-badge">—</span>
  </div>
  <div class="nav-item" onclick="showSiteView('','system')">
    <div class="nav-dot" style="background:var(--text3)"></div>
    Processus pm2
  </div>
  <div class="nav-item" onclick="showSiteView('','runs')">
    <div class="nav-dot" style="background:var(--yellow)"></div>
    Logs d'exécution
  </div>

  <!-- GESTION -->
  <div class="nav-section" style="margin-top:10px">Gestion</div>
  <div class="nav-item" onclick="showSiteView('','onboarding')">
    <div class="nav-dot" style="background:var(--orange)"></div>
    Ajouter un site
  </div>

  <div style="margin-top:auto;padding:8px;">
    <div style="color:var(--text3);font-size:9px;letter-spacing:1px;">
      AUTO-REFRESH<br>
      <span id="refresh-countdown" style="color:var(--text2);">10s</span>
    </div>
  </div>
</nav>

<!-- Color picker popup (partagé) -->
<div class="site-color-popup" id="site-color-popup">
  <div class="site-color-popup-title" id="site-color-popup-title">Couleur du site</div>
  <div class="site-color-swatches">
    <div class="swatch" style="background:#06b6d4" onclick="applyColorChoice('#06b6d4')" title="Cyan"></div>
    <div class="swatch" style="background:#22c55e" onclick="applyColorChoice('#22c55e')" title="Vert"></div>
    <div class="swatch" style="background:#f97316" onclick="applyColorChoice('#f97316')" title="Orange"></div>
    <div class="swatch" style="background:#8b5cf6" onclick="applyColorChoice('#8b5cf6')" title="Violet"></div>
    <div class="swatch" style="background:#ef4444" onclick="applyColorChoice('#ef4444')" title="Rouge"></div>
    <div class="swatch" style="background:#eab308" onclick="applyColorChoice('#eab308')" title="Jaune"></div>
    <div class="swatch" style="background:#3b82f6" onclick="applyColorChoice('#3b82f6')" title="Bleu"></div>
    <div class="swatch" style="background:#f472b6" onclick="applyColorChoice('#f472b6')" title="Rose"></div>
    <div class="swatch" style="background:#94a3b8" onclick="applyColorChoice('#94a3b8')" title="Gris"></div>
    <div class="swatch" style="background:#10b981" onclick="applyColorChoice('#10b981')" title="Émeraude"></div>
  </div>
</div>

<!-- MAIN -->
<main id="main">

  <!-- ═══ VUE GLOBALE ═══ -->
  <div id="view-overview">

    <!-- Notification banner -->
    <div id="overview-alerts" style="display:none;flex-direction:column;gap:8px;margin-bottom:14px"></div>

    <!-- KPI row -->
    <div class="cards-row cards-4" style="margin-bottom:14px">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Campagnes actives</span>
          <div class="card-icon" style="background:rgba(129,140,249,.1);font-size:18px">📧</div>
        </div>
        <div class="card-value" id="kpi-campaigns">—</div>
        <div class="card-sub" id="kpi-campaigns-sub">—</div>
      </div>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Articles publiés</span>
          <div class="card-icon" style="background:rgba(129,140,249,.1);font-size:18px">📝</div>
        </div>
        <div class="card-value" id="kpi-articles">—</div>
        <div class="card-sub">LCR + MKD</div>
      </div>
      <div class="card" id="kpi-budget-lcr-card">
        <div class="card-header">
          <span class="card-title">Budget LCR (7j)</span>
          <div class="card-icon" style="background:rgba(34,211,238,.1);font-size:14px">💰</div>
        </div>
        <div class="card-value" id="kpi-budget-lcr" style="color:var(--cyan)">—</div>
        <div class="card-sub" id="kpi-budget-lcr-sub">/ $10 max</div>
      </div>
      <div class="card" id="kpi-budget-mkd-card">
        <div class="card-header">
          <span class="card-title">Budget MKD (7j)</span>
          <div class="card-icon" style="background:rgba(74,222,128,.1);font-size:14px">💰</div>
        </div>
        <div class="card-value" id="kpi-budget-mkd" style="color:var(--green)">—</div>
        <div class="card-sub" id="kpi-budget-mkd-sub">/ $10 max</div>
      </div>
    </div>

    <!-- Mind map + Budget IA -->
    <div class="cards-row cards-2" style="margin-bottom:14px">
      <!-- Mind map -->
      <div class="canvas-card" style="height:300px;position:relative">
        <div style="position:absolute;top:14px;left:18px;font-size:11px;font-weight:600;color:var(--muted-foreground);z-index:2">Agent Swarm — Radial Mind Map</div>
        <canvas id="mindmap-canvas" style="width:100%;height:100%;display:block"></canvas>
      </div>

      <!-- Budget IA -->
      <div class="table-card">
        <div class="table-card-header">
          <span class="table-card-title">Budget IA / API</span>
          <span class="tag tag-gray" id="budget-ia-period">7 jours</span>
          <div style="display:flex;gap:4px;margin-left:auto">
            <button id="ia-filter-all" onclick="setIAFilter('all')" class="tag tag-cyan" style="cursor:pointer;border:none;font-family:inherit">Tous</button>
            <button id="ia-filter-lcr" onclick="setIAFilter('lcr')" class="tag tag-gray" style="cursor:pointer;border:none;font-family:inherit">LCR</button>
            <button id="ia-filter-mkd" onclick="setIAFilter('mkd')" class="tag tag-gray" style="cursor:pointer;border:none;font-family:inherit">MKD</button>
          </div>
        </div>
        <div id="budget-ia-rows">
          <table style="width:100%;border-collapse:collapse;font-size:11px">
            <thead>
              <tr style="border-bottom:1px solid var(--border)">
                <th style="padding:8px 14px;text-align:left;color:var(--muted-foreground);font-weight:600;letter-spacing:.4px;border-right:1px solid var(--border)">FOURNISSEUR</th>
                <th style="padding:8px 10px;text-align:right;color:var(--muted-foreground);font-weight:600;border-right:1px solid var(--border)">APPELS</th>
                <th style="padding:8px 10px;text-align:right;color:var(--muted-foreground);font-weight:600;border-right:1px solid var(--border)">$/SEM</th>
                <th style="padding:8px 10px;text-align:right;color:var(--muted-foreground);font-weight:600;border-right:1px solid var(--border)">$/MOIS EST.</th>
                <th style="padding:8px 10px;text-align:right;color:var(--muted-foreground);font-weight:600">$/AN EST.</th>
              </tr>
            </thead>
            <tbody id="budget-ia-tbody">
              <tr><td colspan="5" style="padding:12px 14px;color:var(--muted-foreground)">Chargement...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Articles table -->
    <div class="table-card" style="margin-bottom:14px">
      <div class="table-card-header">
        <span class="table-card-title">Articles publiés</span>
        <span class="tag tag-gray" id="articles-site-badge">LCR + MKD</span>
      </div>
      <table>
        <thead><tr>
          <th>SITE</th><th>TITRE</th><th>STATUT</th><th>DATE</th>
          <th style="color:var(--yellow)">COÛT</th>
          <th>INDEXÉ G.</th><th>B.</th><th>Y.</th>
          <th>VISITEURS</th><th>URL</th>
        </tr></thead>
        <tbody id="overview-articles-tbody">
          <tr><td colspan="10" style="color:var(--muted-foreground)">Chargement...</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Modules status -->
    <div class="cards-row cards-3">
      <div class="card" id="module-briefing">
        <div class="card-header">
          <span class="card-title">Briefing</span>
          <span class="tag tag-gray" id="mod-briefing-status">—</span>
        </div>
        <div style="color:var(--muted-foreground);font-size:11px" id="mod-briefing-last">Jamais exécuté</div>
      </div>
      <div class="card" id="module-content">
        <div class="card-header">
          <span class="card-title">Content</span>
          <span class="tag tag-gray" id="mod-content-status">—</span>
        </div>
        <div style="color:var(--muted-foreground);font-size:11px" id="mod-content-last">Jamais exécuté</div>
      </div>
      <div class="card" id="module-crm">
        <div class="card-header">
          <span class="card-title">CRM Sync</span>
          <span class="tag tag-gray" id="mod-crm-status">—</span>
        </div>
        <div style="color:var(--muted-foreground);font-size:11px" id="mod-crm-last">Jamais exécuté</div>
      </div>
    </div>
  </div>

  <!-- ═══ SITE LCR — Setup & Objectifs ═══ -->
  <div id="view-site-lcr" style="display:none">

    <!-- Objectifs agents -->
    <div class="card setup-section">
      <div class="card-header">
        <span class="card-title">Objectifs &amp; Instructions agents</span>
        <button onclick="saveObjectives('lcr')" style="background:rgba(249,115,22,.12);border:1px solid rgba(249,115,22,.3);color:var(--orange);border-radius:4px;padding:3px 10px;cursor:pointer;font-size:10px;font-family:inherit;letter-spacing:.5px">SAUVEGARDER</button>
      </div>
      <div class="setup-label" style="margin-bottom:6px">Ces instructions sont injectées dans le contexte de chaque agent Genesis pour ce site.</div>
      <textarea class="objectives-area" id="objectives-lcr" placeholder="Ex: Ce site cible les gérants de commerce local en France. Objectif SEO : ranker sur &quot;sms marketing&quot; et &quot;campagne sms&quot;. Ton éditorial : expert, concret, avec chiffres. 1 article/semaine max. CTA = Découvrez la solution SMS LeClientROI..."></textarea>
      <div style="font-size:9px;color:var(--text3);margin-top:4px">Stocké localement · Injecté dans content_agent.py, seo_agent.py, briefing.py</div>
    </div>

    <div class="cards-row cards-3">
      <div class="card" style="border-color:rgba(6,182,212,.3)">
        <div class="card-title" style="color:var(--cyan)">leclientroi.com</div>
        <div style="margin-top:6px;font-size:10px;color:var(--text2)">CMS: Emdash · localhost:4321<br>Blog: blog.leclientroi.com</div>
      </div>
      <div class="card"><div class="card-title">Articles publiés</div><div class="card-value" id="lcr-articles-count" style="margin-top:8px">—</div></div>
      <div class="card"><div class="card-title">Coût LCR (7j)</div><div class="card-value" id="lcr-cost" style="margin-top:8px;color:var(--yellow)">—</div></div>
    </div>
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header">
        <span class="table-card-title">Articles LCR — backlog &amp; publiés</span>
        <a href="https://blog.leclientroi.com" target="_blank" style="color:var(--cyan);font-size:10px;text-decoration:none">↗ voir le blog</a>
      </div>
      <table>
        <thead><tr><th>TITRE</th><th>STATUT</th><th>DATE</th><th>LIEN</th></tr></thead>
        <tbody id="lcr-articles-tbody"><tr><td colspan="4" style="color:var(--text3)">Chargement...</td></tr></tbody>
      </table>
    </div>
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header">
        <span class="table-card-title">Modules LCR</span>
        <span id="lcr-modules-status" style="font-size:9px;color:var(--text3)">Vérification...</span>
      </div>
      <div class="module-grid" id="lcr-modules-grid">
        <div style="color:var(--text3);font-size:11px;padding:8px 0">Chargement des connecteurs...</div>
      </div>
    </div>
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header"><span class="table-card-title">Runs récents sur LCR</span></div>
      <table>
        <thead><tr><th>DATE</th><th>ACTION</th><th>STATUT</th><th>TOKENS</th><th>COÛT EUR</th></tr></thead>
        <tbody id="lcr-runs-tbody"><tr><td colspan="5" style="color:var(--text3)">Chargement...</td></tr></tbody>
      </table>
    </div>
  </div>

  <!-- ═══ SITE MKD — Setup & Objectifs ═══ -->
  <div id="view-site-mkd" style="display:none">

    <!-- Objectifs agents -->
    <div class="card setup-section">
      <div class="card-header">
        <span class="card-title">Objectifs &amp; Instructions agents</span>
        <button onclick="saveObjectives('mkd')" style="background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:var(--green);border-radius:4px;padding:3px 10px;cursor:pointer;font-size:10px;font-family:inherit;letter-spacing:.5px">SAUVEGARDER</button>
      </div>
      <div class="setup-label" style="margin-bottom:6px">Ces instructions sont injectées dans le contexte de chaque agent Genesis pour ce site.</div>
      <textarea class="objectives-area" id="objectives-mkd" placeholder="Ex: Site B2B ciblant les responsables marketing et DRH en France. Objectif SEO : ranker sur &quot;prospection B2B&quot;, &quot;RCS entreprise&quot;, &quot;data marketing RGPD&quot;. Articles techniques avec cas clients. CTA = Demander une démo MKD Groupe..."></textarea>
      <div style="font-size:9px;color:var(--text3);margin-top:4px">Stocké localement · Injecté dans content_agent.py, seo_agent.py, briefing.py</div>
    </div>

    <div class="cards-row cards-3">
      <div class="card" style="border-color:rgba(34,197,94,.3)">
        <div class="card-title" style="color:var(--green)">mkdgroupe.com</div>
        <div style="margin-top:6px;font-size:10px;color:var(--text2)">CMS: WordPress<br>Blog: mkdgroupe.com/blog</div>
      </div>
      <div class="card"><div class="card-title">Articles publiés</div><div class="card-value" id="mkd-articles-count" style="margin-top:8px">—</div></div>
      <div class="card"><div class="card-title">Coût MKD (7j)</div><div class="card-value" id="mkd-cost" style="margin-top:8px;color:var(--yellow)">—</div></div>
    </div>
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header">
        <span class="table-card-title">Articles MKD — WordPress</span>
        <a href="https://mkdgroupe.com" target="_blank" style="color:var(--green);font-size:10px;text-decoration:none">↗ voir le site</a>
      </div>
      <table>
        <thead><tr><th>TITRE</th><th>STATUT</th><th>DATE</th><th>LIEN</th></tr></thead>
        <tbody id="mkd-articles-tbody"><tr><td colspan="4" style="color:var(--text3)">Chargement...</td></tr></tbody>
      </table>
    </div>
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header">
        <span class="table-card-title">Modules MKD</span>
        <span id="mkd-modules-status" style="font-size:9px;color:var(--text3)">Vérification...</span>
      </div>
      <div class="module-grid" id="mkd-modules-grid">
        <div style="color:var(--text3);font-size:11px;padding:8px 0">Chargement des connecteurs...</div>
      </div>
    </div>
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header"><span class="table-card-title">Runs récents sur MKD</span></div>
      <table>
        <thead><tr><th>DATE</th><th>ACTION</th><th>STATUT</th><th>TOKENS</th><th>COÛT EUR</th></tr></thead>
        <tbody id="mkd-runs-tbody"><tr><td colspan="5" style="color:var(--text3)">Chargement...</td></tr></tbody>
      </table>
    </div>
  </div>

  <!-- ═══ CAMPAGNES ═══ -->
  <div id="view-campaigns" style="display:none">

    <!-- KPIs Cold Email -->
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:14px">
      <div class="card"><div class="kpi-label">Total envoyés</div><div class="kpi-value" id="ce-total">—</div></div>
      <div class="card"><div class="kpi-label" style="color:var(--green)">OK</div><div class="kpi-value" style="color:var(--green)" id="ce-ok">—</div></div>
      <div class="card"><div class="kpi-label" style="color:var(--red)">Rejetés</div><div class="kpi-value" style="color:var(--red)" id="ce-rej">—</div></div>
      <div class="card"><div class="kpi-label" style="color:var(--yellow)">Droppés</div><div class="kpi-value" style="color:var(--yellow)" id="ce-drop">—</div></div>
      <div class="card"><div class="kpi-label" style="color:var(--orange)">Erreurs</div><div class="kpi-value" style="color:var(--orange)" id="ce-err">—</div></div>
    </div>

    <!-- Tabs -->
    <div style="display:flex;gap:8px;margin-bottom:12px">
      <button onclick="ceTab('overview')" id="cetab-overview" class="tag tag-cyan" style="cursor:pointer">Vue globale</button>
      <button onclick="ceTab('sources')" id="cetab-sources" class="tag tag-gray" style="cursor:pointer">Par source</button>
      <button onclick="ceTab('search')" id="cetab-search" class="tag tag-gray" style="cursor:pointer">Recherche</button>
      <button onclick="ceTab('export')" id="cetab-export" class="tag tag-gray" style="cursor:pointer">Export CSV</button>
      <span style="margin-left:auto;cursor:pointer;color:var(--text3);font-size:11px" onclick="loadCampaigns()">↻ Rafraîchir</span>
    </div>

    <!-- Overview -->
    <div id="ce-view-overview">
      <div class="card" style="margin-bottom:12px">
        <div style="font-size:11px;font-weight:700;margin-bottom:10px">Envois par mois</div>
        <div style="height:160px"><canvas id="ce-chart-monthly"></canvas></div>
      </div>
      <div class="card">
        <div style="font-size:11px;font-weight:700;margin-bottom:10px">Par source</div>
        <table style="width:100%;border-collapse:collapse;font-size:11px">
          <thead><tr style="color:var(--text3);text-align:left">
            <th style="padding:4px 8px">Source</th>
            <th style="padding:4px 8px;text-align:right">Total</th>
            <th style="padding:4px 8px;text-align:right;color:var(--green)">OK</th>
            <th style="padding:4px 8px;text-align:right;color:var(--red)">Rejet</th>
            <th style="padding:4px 8px;text-align:right;color:var(--yellow)">Drop</th>
            <th style="padding:4px 8px;text-align:right;color:var(--orange)">Err</th>
          </tr></thead>
          <tbody id="ce-sources-tbody"><tr><td colspan="6" style="padding:8px;color:var(--text3)">Chargement...</td></tr></tbody>
        </table>
      </div>
      <!-- Campagnes Emelia actives -->
      <div class="card" style="margin-top:12px">
        <div style="font-size:11px;font-weight:700;margin-bottom:10px">Campagnes Emelia</div>
        <div id="campaigns-body"><div style="color:var(--text3)">Chargement...</div></div>
      </div>
    </div>

    <!-- Par source -->
    <div id="ce-view-sources" style="display:none">
      <div class="card">
        <select id="ce-src-select" onchange="loadCESource(this.value)" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--text1);border-radius:4px;padding:4px 8px;font-size:11px;font-family:inherit;margin-bottom:12px;width:100%;max-width:400px"></select>
        <div id="ce-src-detail"><div style="color:var(--text3)">Sélectionne une source</div></div>
      </div>
    </div>

    <!-- Recherche -->
    <div id="ce-view-search" style="display:none">
      <div class="card">
        <div style="display:flex;gap:8px;margin-bottom:12px">
          <input id="ce-search-input" type="text" placeholder="Email ou GSM…" style="flex:1;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--text1);border-radius:4px;padding:6px 10px;font-size:11px;font-family:inherit">
          <button onclick="doCESearch()" style="padding:4px 14px;background:rgba(59,130,246,.15);border:1px solid rgba(59,130,246,.3);color:var(--blue);border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">Chercher</button>
        </div>
        <div id="ce-search-results" style="font-size:11px;color:var(--text3)">Saisis au moins 4 caractères.</div>
      </div>
    </div>

    <!-- Export -->
    <div id="ce-view-export" style="display:none">
      <div class="card" style="max-width:400px">
        <div style="font-size:11px;font-weight:700;margin-bottom:12px">Exporter en CSV</div>
        <div style="margin-bottom:8px"><label style="font-size:10px;color:var(--text3)">Du (DD/MM/YYYY)</label>
          <input id="ce-exp-from" type="text" placeholder="01/04/2026" style="width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--text1);border-radius:4px;padding:6px 10px;font-size:11px;font-family:inherit;margin-top:4px"></div>
        <div style="margin-bottom:12px"><label style="font-size:10px;color:var(--text3)">Au (DD/MM/YYYY)</label>
          <input id="ce-exp-to" type="text" placeholder="30/04/2026" style="width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--text1);border-radius:4px;padding:6px 10px;font-size:11px;font-family:inherit;margin-top:4px"></div>
        <button onclick="doCEExport()" style="padding:6px 18px;background:rgba(34,197,94,.15);border:1px solid rgba(34,197,94,.3);color:var(--green);border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">Télécharger CSV</button>
      </div>
    </div>

  </div>

  <!-- ═══ ARTICLES ═══ -->
  <div id="view-articles" style="display:none">
    <div class="table-card">
      <div class="table-card-header">
        <span class="table-card-title">Articles publiés</span>
        <span id="articles-site-badge" class="tag tag-gray" style="font-size:9px"></span>
      </div>
      <table>
        <thead>
          <tr>
            <th>SITE</th>
            <th>TITRE</th>
            <th>STATUT</th>
            <th>DATE</th>
            <th style="color:var(--yellow)">COÛT</th>
            <th title="Indexation moteurs de recherche — à venir">INDEXÉ G.</th>
            <th title="Bing — à venir">B.</th>
            <th title="Yandex — à venir">Y.</th>
            <th>URL</th>
          </tr>
        </thead>
        <tbody id="articles-tbody">
          <tr><td colspan="9" style="color:var(--text3)">Chargement...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ═══ CRM ═══ -->
  <div id="view-crm" style="display:none">
    <div class="cards-row cards-3">
      <div class="card">
        <div class="card-title">Contacts Twenty</div>
        <div class="card-value" id="crm-total" style="margin-top:8px">—</div>
