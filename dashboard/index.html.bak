        </div>
        <div id="seo-mkd-content">
          <div style="padding:16px;color:var(--text3);text-align:center">
            Aucune donnée — lancer une analyse ou configurer AHREFS_API_KEY
          </div>
        </div>
      </div>

    </div>

    <!-- Opportunités mots-clés -->
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header">
