        <div class="card-value" id="seo-units-week" style="margin-top:8px;color:var(--green)">—</div>
        <div class="card-sub">consommées (budget plan)</div>
      </div>
      <div class="card">
        <div class="card-title">DR — leclientroi.com</div>
        <div class="card-value" id="seo-dr-lcr" style="margin-top:8px;color:var(--cyan)">—</div>
