        <div class="card-sub">exécutés dans les 24h</div>
      </div>
      <div class="card">
        <div class="card-title">Alertes Telegram</div>
        <div class="card-value" id="svc-alerts" style="margin-top:8px;color:var(--yellow)">—</div>
        <div class="card-sub">envoyées ce check</div>
      </div>
    </div>

    <div id="services-grid" style="display:flex;flex-direction:column;gap:10px"></div>

    <div style="margin-top:12px;display:flex;align-items:center;gap:12px">
      <button onclick="loadServices()" style="background:rgba(249,115,22,.15);color:var(--orange);border:1px solid rgba(249,115,22,.3);padding:6px 16px;border-radius:6px;cursor:pointer;font-family:monospace;font-size:11px">
        ↻ Rafraîchir &amp; re-checker
      </button>
      <span id="services-checked-at" style="color:var(--text3);font-size:10px"></span>
    </div>
  </div>

  <!-- ═══ SYSTÈME ═══ -->
  <div id="view-system" style="display:none">
    <div class="table-card">
      <div class="table-card-header">
        <span class="table-card-title">Processus pm2</span>
      </div>
      <table>
        <thead><tr><th>NOM</th><th>STATUT</th><th>CPU</th><th>MÉMOIRE</th></tr></thead>
        <tbody id="system-tbody">
          <tr><td colspan="4" style="color:var(--text3)">Chargement...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ═══ BUDGET ═══ -->
  <div id="view-budget" style="display:none">

    <!-- KPIs row 1: Semaine + LCR + MKD + Ahrefs -->
    <div class="cards-row cards-4">
      <div class="card">
        <div class="card-title">Budget semaine</div>
        <div class="card-value" id="budget-week-eur" style="margin-top:8px;color:var(--cyan)">—</div>
        <div class="card-sub" id="budget-week-usd">/ 9,20 € max (10 $)</div>
        <div style="margin-top:10px">
          <div class="progress-wrap">
            <div class="progress-bar" id="budget-week-bar" style="background:var(--green);width:0%"></div>
          </div>
          <div id="budget-week-pct" style="color:var(--text3);font-size:9px;margin-top:3px">0%</div>
        </div>
      </div>
      <div class="card" style="border-color:rgba(6,182,212,.3)">
        <div class="card-title" style="color:var(--cyan)">LCR — semaine</div>
        <div class="card-value" id="budget-lcr-eur" style="margin-top:8px">—</div>
        <div class="card-sub" id="budget-lcr-tok">— tokens</div>
      </div>
      <div class="card" style="border-color:rgba(34,197,94,.3)">
        <div class="card-title" style="color:var(--green)">MKD — semaine</div>
        <div class="card-value" id="budget-mkd-eur" style="margin-top:8px">—</div>
        <div class="card-sub" id="budget-mkd-tok">— tokens</div>
      </div>
      <div class="card" style="border-color:rgba(249,115,22,.3)">
        <div class="card-title">Crédits Ahrefs</div>
        <div class="card-value" id="budget-ahrefs-used" style="margin-top:8px;color:var(--orange)">—</div>
        <div class="card-sub">/ 25 000 / mois</div>
        <div style="margin-top:8px">
          <div class="progress-wrap">
            <div class="progress-bar" id="budget-ahrefs-bar" style="background:var(--orange);width:0%"></div>
          </div>
          <div style="color:var(--text3);font-size:9px;margin-top:3px">
            <a href="https://app.ahrefs.com/dashboard" target="_blank" style="color:var(--orange);text-decoration:none">↗ app.ahrefs.com</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 2: Répartition modules + Top 5 -->
    <div class="cards-row cards-2" style="margin-top:14px">
      <div class="card">
        <div class="card-title" style="margin-bottom:14px">Répartition par module — 7 jours</div>
        <div id="budget-module-bars"><div style="color:var(--text3);font-size:11px;text-align:center;padding:16px">Aucune donnée</div></div>
      </div>
      <div class="table-card">
        <div class="table-card-header">
          <span class="table-card-title">Top 5 actions — 7 jours</span>
          <button id="budget-filter-clear" onclick="filterAction('')" style="display:none;background:none;border:1px solid rgba(239,68,68,.4);color:var(--red);border-radius:3px;cursor:pointer;font-size:9px;padding:2px 7px;font-family:inherit;letter-spacing:.5px">RESET FILTRE</button>
        </div>
        <table>
          <thead><tr><th>ACTION</th><th>MODULE</th><th>APPELS</th><th>COÛT EUR</th><th></th></tr></thead>
          <tbody id="budget-top5"><tr><td colspan="5" style="color:var(--text3)">Aucune donnée</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- Row 3: Par module + par modèle -->
    <div class="cards-row cards-2" style="margin-top:14px">
      <div class="table-card">
        <div class="table-card-header"><span class="table-card-title">Coût par module — 7 jours</span></div>
        <table>
          <thead><tr><th>MODULE</th><th>APPELS</th><th>TOKENS</th><th>COÛT EUR</th></tr></thead>
          <tbody id="budget-by-module"></tbody>
        </table>
      </div>
      <div class="table-card">
        <div class="table-card-header"><span class="table-card-title">Coût par modèle — 7 jours</span></div>
        <table>
          <thead><tr><th>MODÈLE</th><th>APPELS</th><th>TOKENS</th><th>COÛT EUR</th></tr></thead>
          <tbody id="budget-by-model"></tbody>
        </table>
      </div>
    </div>

    <!-- Historique avec delete -->
    <div class="table-card" style="margin-top:14px">
      <div class="table-card-header">
        <span class="table-card-title">Historique des appels API</span>
        <div style="display:flex;gap:8px;align-items:center">
          <span style="color:var(--text3);font-size:9px">30j:</span>
          <span id="budget-month-eur" class="tag tag-gray">—</span>
          <span style="color:var(--text3);font-size:9px">total:</span>
          <span id="budget-all-eur" class="tag tag-gray">—</span>
          <span id="budget-entries-count" class="tag tag-cyan">—</span>
        </div>
      </div>
      <table>
        <thead><tr><th>DATE</th><th>ACTION</th><th>MODULE</th><th>SITE</th><th>MODÈLE</th><th>TOKENS</th><th>COÛT EUR</th><th></th></tr></thead>
        <tbody id="budget-entries-tbody">
          <tr><td colspan="8" style="color:var(--text3)">Aucune entrée</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ═══ VUE SEO ═══ -->
  <div id="view-seo" style="display:none">

    <!-- Header bar -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
      <span style="font-size:13px;font-weight:700;color:var(--green)">Analyse SEO — Ahrefs</span>
      <span id="seo-config-badge" class="tag tag-gray">chargement...</span>
      <button onclick="triggerSeoRun()" id="seo-run-btn"
        style="margin-left:auto;padding:4px 12px;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:var(--green);border-radius:4px;cursor:pointer;font-size:10px;font-family:inherit;letter-spacing:1px">
        LANCER ANALYSE
      </button>
    </div>

    <!-- KPIs units + last sync -->
    <div class="cards-row cards-4" style="margin-bottom:14px">
      <div class="card">
