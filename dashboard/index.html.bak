        </tbody>
      </table>
    </div>

  </div>


  <!-- ═══ INDEXATION ═══ -->
  <div id="view-indexation" style="display:none">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
      <span style="font-size:13px;font-weight:700;color:var(--yellow)">Indexation — Sitemap & IndexNow</span>
      <span id="idx-status-badge" class="tag tag-gray">chargement...</span>
      <div style="margin-left:auto;display:flex;gap:8px">
        <select id="idx-site-select" onchange="loadIndexation()" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--text1);border-radius:4px;padding:4px 8px;font-size:10px;font-family:inherit">
          <option value="lcr">LCR</option>
          <option value="mkd">MKD</option>
        </select>
        <button onclick="triggerIndexation()" style="padding:4px 12px;background:rgba(234,179,8,.12);border:1px solid rgba(234,179,8,.3);color:var(--yellow);border-radius:4px;cursor:pointer;font-size:10px;font-family:inherit;letter-spacing:1px">
          LANCER AUDIT
        </button>
      </div>
    </div>

    <!-- KPI row -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px">
      <div class="card"><div class="kpi-label">Dans sitemap</div><div class="kpi-value" id="idx-sitemap-count">—</div></div>
      <div class="card"><div class="kpi-label">Articles CMS</div><div class="kpi-value" id="idx-cms-count">—</div></div>
      <div class="card"><div class="kpi-label" style="color:var(--red)">Manquants</div><div class="kpi-value" style="color:var(--red)" id="idx-missing-count">—</div></div>
      <div class="card"><div class="kpi-label">URLs cassées</div><div class="kpi-value" id="idx-broken-count">—</div></div>
    </div>

    <!-- Missing articles -->
    <div class="card" style="margin-bottom:14px">
      <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--yellow)">Articles manquants du sitemap (Google ne les voit pas)</div>
      <table style="width:100%;border-collapse:collapse;font-size:11px">
        <thead><tr style="color:var(--text3);text-align:left">
          <th style="padding:4px 8px">Titre</th>
          <th style="padding:4px 8px">URL</th>
          <th style="padding:4px 8px">Date</th>
        </tr></thead>
        <tbody id="idx-missing-tbody">
          <tr><td colspan="3" style="color:var(--text3);padding:8px">Chargement...</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Daily submission status -->
    <div class="card" style="margin-bottom:14px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <div style="font-size:11px;font-weight:700;color:var(--text2)">Soumission quotidienne (IndexNow)</div>
        <span id="idx-daily-badge" class="tag tag-gray">—</span>
        <button onclick="triggerDailyIndexation()" style="margin-left:auto;padding:3px 10px;background:rgba(59,130,246,.12);border:1px solid rgba(59,130,246,.3);color:var(--blue);border-radius:4px;cursor:pointer;font-size:10px;font-family:inherit;letter-spacing:1px">
          LANCER MAINTENANT
        </button>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px">
        <div style="background:rgba(255,255,255,.03);border-radius:6px;padding:8px">
          <div class="kpi-label">Total suivi</div>
          <div class="kpi-value" id="idx-daily-total" style="font-size:18px">—</div>
        </div>
        <div style="background:rgba(255,255,255,.03);border-radius:6px;padding:8px">
          <div class="kpi-label">Nouveaux (dernier run)</div>
          <div class="kpi-value" id="idx-daily-new" style="font-size:18px;color:var(--green)">—</div>
        </div>
        <div style="background:rgba(255,255,255,.03);border-radius:6px;padding:8px">
          <div class="kpi-label">Soumis IndexNow</div>
          <div class="kpi-value" id="idx-daily-inow" style="font-size:18px">—</div>
        </div>
        <div style="background:rgba(255,255,255,.03);border-radius:6px;padding:8px">
          <div class="kpi-label">Dernier run</div>
          <div class="kpi-value" id="idx-daily-date" style="font-size:11px;color:var(--text3)">—</div>
        </div>
      </div>
      <div id="idx-daily-urls" style="font-size:10px;color:var(--text3)"></div>
    </div>

    <!-- IndexNow instructions -->
    <div class="card">
      <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--text2)">Actions requises</div>
      <div style="font-size:10px;color:var(--text3);line-height:1.8">
        <p>1. <strong style="color:var(--text2)">Déployer nginx patches</strong> — <code style="background:rgba(255,255,255,.05);padding:2px 6px;border-radius:3px">sudo cp dashboard/nginx-seo-patches.conf /etc/nginx/sites-available/ && sudo nginx -t && sudo nginx -s reload</code></p>
        <p>2. <strong style="color:var(--text2)">Clé IndexNow</strong> — Le fichier clé est servi automatiquement par nginx une fois déployé</p>
        <p>3. <strong style="color:var(--text2)">Bing Webmaster</strong> — Ajouter <code style="background:rgba(255,255,255,.05);padding:2px 6px;border-radius:3px">BING_WEBMASTER_KEY=xxx</code> dans .env</p>
        <p>4. <strong style="color:var(--text2)">Sitemap LCR</strong> — <code style="background:rgba(255,255,255,.05);padding:2px 6px;border-radius:3px">data/sitemap-lcr.xml</code> contient tous les articles — déployé via nginx patches</p>
        <p>5. <strong style="color:var(--text2)">Submit IndexNow</strong> — <code style="background:rgba(255,255,255,.05);padding:2px 6px;border-radius:3px">python3 scripts/indexation_agent.py --task submit --site lcr --live</code></p>
        <p>6. <strong style="color:var(--text2)">Cron quotidien</strong> — <code style="background:rgba(255,255,255,.05);padding:2px 6px;border-radius:3px">genesis-indexation-daily</code> (pm2) — tourne à 5h UTC chaque jour</p>
      </div>
    </div>

  </div>

  <!-- ═══ ONBOARDING ═══ -->
  <div id="view-onboarding" style="display:none">

    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
      <span style="font-size:13px;font-weight:700;color:#f97316">Ajouter un nouveau site</span>
      <span id="wizard-status-badge" class="tag tag-gray">Étape 1/5</span>
      <div id="wizard-sites-list" style="margin-left:auto;display:flex;gap:6px"></div>
    </div>

    <!-- Sites enregistrés -->
    <div id="wizard-registered-sites" class="card" style="margin-bottom:14px;display:none">
      <div style="font-size:11px;font-weight:700;margin-bottom:8px;color:var(--text2)">Sites enregistrés</div>
      <div id="wizard-sites-table"></div>
    </div>

    <!-- Étapes indicator -->
    <div class="wizard-steps" style="margin-bottom:20px">
      <div class="wizard-step-dot active" id="wdot-1" onclick="wizardGoTo(1)">1</div>
      <div class="wizard-connector"></div>
      <div class="wizard-step-dot" id="wdot-2" onclick="wizardGoTo(2)">2</div>
      <div class="wizard-connector"></div>
      <div class="wizard-step-dot" id="wdot-3" onclick="wizardGoTo(3)">3</div>
      <div class="wizard-connector"></div>
      <div class="wizard-step-dot" id="wdot-4" onclick="wizardGoTo(4)">4</div>
      <div class="wizard-connector"></div>
      <div class="wizard-step-dot" id="wdot-5" onclick="wizardGoTo(5)">5</div>
    </div>

    <!-- STEP 1 — Identité -->
    <div id="wstep-1">
      <div class="card" style="margin-bottom:12px">
        <div style="font-size:11px;font-weight:700;margin-bottom:12px;color:#f97316">Étape 1 — Identité du site</div>
        <div class="wizard-grid-2">
          <div class="wizard-field">
            <label>Code unique *</label>
            <input id="w-code" type="text" placeholder="ex: site3" pattern="[a-z][a-z0-9]{1,15}"
              oninput="this.value=this.value.toLowerCase().replace(/[^a-z0-9]/g,'')" />
            <div id="w-code-status" style="font-size:10px;margin-top:3px;color:var(--text3)">2-16 caractères, lettres/chiffres minuscules</div>
          </div>
          <div class="wizard-field">
            <label>Nom d'affichage *</label>
            <input id="w-label" type="text" placeholder="ex: Mon Site" />
          </div>
        </div>
        <div class="wizard-grid-2">
          <div class="wizard-field">
            <label>Domaine (sans https) *</label>
            <input id="w-domain" type="text" placeholder="monsite.com"
              onblur="document.getElementById('w-url').value='https://'+this.value;document.getElementById('w-sitemap').value='https://'+this.value+'/sitemap.xml';document.getElementById('w-blog-prefix').value='https://'+this.value+'/blog/';" />
          </div>
          <div class="wizard-field">
            <label>URL complète *</label>
            <input id="w-url" type="text" placeholder="https://monsite.com" />
          </div>
        </div>
        <div class="wizard-grid-3">
          <div class="wizard-field">
            <label>Pays</label>
            <select id="w-country">
              <option value="fr" selected>France (fr)</option>
              <option value="be">Belgique (be)</option>
              <option value="ch">Suisse (ch)</option>
              <option value="ca">Canada (ca)</option>
            </select>
          </div>
          <div class="wizard-field">
            <label>Langue</label>
            <select id="w-language">
              <option value="fr" selected>Français</option>
              <option value="en">English</option>
            </select>
          </div>
          <div class="wizard-field">
            <label>Couleur principale</label>
            <input id="w-color" type="color" value="#3b82f6" style="height:38px;padding:2px 6px;cursor:pointer" />
          </div>
        </div>
        <div class="wizard-field">
          <label>Type de CMS *</label>
          <div class="cms-toggle">
            <div class="cms-btn selected" id="cms-emdash" onclick="selectCMS('emdash')">Emdash</div>
            <div class="cms-btn" id="cms-wordpress" onclick="selectCMS('wordpress')">WordPress</div>
          </div>
        </div>
      </div>
    </div>

    <!-- STEP 2 — CMS Credentials -->
    <div id="wstep-2" style="display:none">
      <div class="card" style="margin-bottom:12px">
        <div style="font-size:11px;font-weight:700;margin-bottom:12px;color:#f97316">Étape 2 — Connexion CMS</div>
        <!-- Emdash fields -->
        <div id="cms-emdash-fields">
          <div class="wizard-field">
            <label>Emdash API URL</label>
            <input id="w-emdash-url" type="text" value="http://localhost:4321" />
          </div>
          <div class="wizard-field">
            <label>Emdash API Token</label>
            <input id="w-emdash-token" type="password" placeholder="ec_pat_..." />
          </div>
        </div>
        <!-- WordPress fields -->
        <div id="cms-wp-fields" style="display:none">
          <div class="wizard-field">
            <label>WordPress URL</label>
            <input id="w-wp-url" type="text" placeholder="https://monsite.com" />
          </div>
          <div class="wizard-grid-2">
            <div class="wizard-field">
              <label>WordPress Username</label>
              <input id="w-wp-user" type="text" placeholder="admin" />
            </div>
            <div class="wizard-field">
              <label>Application Password</label>
              <input id="w-wp-pass" type="password" placeholder="xxxx xxxx xxxx..." />
            </div>
          </div>
        </div>
        <div class="wizard-field">
          <label>URL du blog (préfixe articles)</label>
          <input id="w-blog-url" type="text" placeholder="https://monsite.com/blog/" />
        </div>
        <div style="display:flex;align-items:center;gap:10px;margin-top:8px">
          <button onclick="testCMSConnection()"
            style="padding:6px 16px;background:rgba(249,115,22,.12);border:1px solid rgba(249,115,22,.3);
            color:#f97316;border-radius:4px;cursor:pointer;font-size:11px;font-family:inherit">
            TESTER LA CONNEXION
          </button>
          <span id="cms-test-result" style="font-size:11px;color:var(--text3)"></span>
        </div>
      </div>
    </div>

    <!-- STEP 3 — SEO & Contenu -->
    <div id="wstep-3" style="display:none">
      <div class="card" style="margin-bottom:12px">
        <div style="font-size:11px;font-weight:700;margin-bottom:12px;color:#f97316">Étape 3 — SEO & Contenu</div>
        <div class="wizard-field">
          <label>Mots-clés cibles (un par ligne, min 2) *</label>
          <textarea id="w-keywords" rows="4" placeholder="sms marketing&#10;campagne sms&#10;sms geolocalise"></textarea>
        </div>
        <div class="wizard-grid-2">
          <div class="wizard-field">
            <label>Ton éditorial</label>
            <input id="w-tone" type="text" placeholder="expert, concret, chiffres clés" />
          </div>
          <div class="wizard-field">
            <label>CTA article</label>
            <input id="w-cta" type="text" placeholder="Découvrez notre solution" />
          </div>
        </div>
        <div class="wizard-grid-2">
          <div class="wizard-field">
            <label>URL Sitemap</label>
            <input id="w-sitemap" type="text" placeholder="https://monsite.com/sitemap.xml" />
          </div>
          <div class="wizard-field">
            <label>Préfixe URL blog</label>
            <input id="w-blog-prefix" type="text" placeholder="https://monsite.com/blog/" />
          </div>
        </div>
        <div class="wizard-field">
          <label>Sources RSS concurrents</label>
          <div id="rss-rows">
            <div class="rss-row">
              <input type="text" placeholder="Nom source" style="max-width:160px" />
              <input type="text" placeholder="URL flux RSS" />
              <button onclick="removeRssRow(this)" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:var(--red);border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-family:inherit">✕</button>
            </div>
          </div>
          <button onclick="addRssRow()" style="margin-top:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);color:var(--text3);border-radius:4px;padding:4px 12px;cursor:pointer;font-size:10px;font-family:inherit">+ Ajouter source RSS</button>
        </div>
        <div class="wizard-field" style="display:flex;align-items:center;gap:8px">
          <input id="w-dir-target" type="checkbox" style="width:auto" />
          <label style="margin:0;text-transform:none;font-size:11px;color:var(--text2)">Ce site est la cible pour la soumission aux annuaires</label>
        </div>
      </div>
    </div>

    <!-- STEP 4 — Newsletter -->
    <div id="wstep-4" style="display:none">
      <div class="card" style="margin-bottom:12px">
        <div style="font-size:11px;font-weight:700;margin-bottom:12px;color:#f97316">Étape 4 — Newsletter</div>
        <div class="wizard-grid-2">
          <div class="wizard-field">
            <label>Nom expéditeur</label>
            <input id="w-from-name" type="text" placeholder="Mon Site" />
          </div>
          <div class="wizard-field">
            <label>Email expéditeur</label>
            <input id="w-from-email" type="email" placeholder="newsletter@monsite.com" />
          </div>
        </div>
        <div class="wizard-field">
          <label>Modèle d'objet</label>
          <input id="w-subject-tpl" type="text" value="Newsletter — Actus du mois {month}" />
        </div>
        <div class="wizard-field">
          <label>Topics newsletter (un par ligne)</label>
          <textarea id="w-topics" rows="3" placeholder="marketing digital&#10;tendances secteur"></textarea>
        </div>
        <div class="wizard-grid-2">
          <div class="wizard-field">
            <label>URL CTA newsletter</label>
            <input id="w-nl-cta-url" type="text" placeholder="https://monsite.com" />
          </div>
          <div class="wizard-field">
            <label>Texte CTA</label>
            <input id="w-nl-cta-label" type="text" placeholder="En savoir plus" />
          </div>
        </div>
        <div class="wizard-field">
          <label>Description footer (max 120 chars)</label>
          <input id="w-footer-desc" type="text" maxlength="120" placeholder="La newsletter des experts en..." />
        </div>
      </div>
    </div>

    <!-- STEP 5 — Contexte RAG -->
    <div id="wstep-5" style="display:none">
      <div style="display:flex;gap:12px">
        <div style="flex:1">
          <div class="card" style="margin-bottom:12px">
            <div style="font-size:11px;font-weight:700;margin-bottom:12px;color:#f97316">Étape 5 — Contexte agents (RAG)</div>
            <div class="wizard-field">
              <label>Description de l'activité *</label>
              <textarea id="w-biz-desc" rows="4" oninput="updateRAGPreview()"
                placeholder="Ce que fait le business en 2-3 paragraphes..."></textarea>
            </div>
            <div class="wizard-grid-2">
              <div class="wizard-field">
                <label>Audience principale</label>
                <input id="w-audience" type="text" oninput="updateRAGPreview()" placeholder="B2B — responsables marketing PME" />
              </div>
              <div class="wizard-field">
                <label>Secteur / industrie</label>
                <input id="w-industry" type="text" oninput="updateRAGPreview()" placeholder="SaaS / Marketing digital" />
              </div>
            </div>
            <div class="wizard-field">
              <label>Proposition de valeur</label>
              <textarea id="w-value-prop" rows="2" oninput="updateRAGPreview()" placeholder="Ce qui différencie du marché..."></textarea>
            </div>
            <div class="wizard-grid-2">
              <div class="wizard-field">
                <label>Concurrents (un domaine par ligne)</label>
                <textarea id="w-competitors" rows="3" oninput="updateRAGPreview()" placeholder="concurrent1.com&#10;concurrent2.fr"></textarea>
              </div>
              <div class="wizard-field">
                <label>Produits / services (un par ligne)</label>
                <textarea id="w-products" rows="3" oninput="updateRAGPreview()" placeholder="Produit 1&#10;Service 2"></textarea>
              </div>
            </div>
            <div class="wizard-field">
              <label>Objectifs SEO</label>
              <input id="w-seo-goals" type="text" oninput="updateRAGPreview()" placeholder="Ranker sur X, DR cible 20 fin 2026" />
            </div>
            <div class="wizard-field">
              <label>Ton de voix</label>
              <input id="w-tone-of-voice" type="text" oninput="updateRAGPreview()" placeholder="expert, friendly, concret" />
            </div>
          </div>
        </div>
        <div style="width:340px">
          <div class="card" style="background:rgba(0,0,0,.2)">
            <div style="font-size:10px;color:var(--text3);margin-bottom:8px;letter-spacing:.5px">PREVIEW — site-context.md</div>
            <pre id="rag-preview" style="font-size:10px;color:var(--text2);white-space:pre-wrap;word-break:break-word;max-height:500px;overflow-y:auto;margin:0;line-height:1.6"></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation buttons -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px">
      <button id="wizard-prev-btn" onclick="wizardPrev()" style="display:none;padding:8px 20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);color:var(--text2);border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit">
        ← Précédent
      </button>
      <span style="flex:1"></span>
      <button id="wizard-next-btn" onclick="wizardNext()" style="padding:8px 24px;background:rgba(249,115,22,.15);border:1px solid rgba(249,115,22,.4);color:#f97316;border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit;letter-spacing:.5px">
        SUIVANT →
      </button>
      <button id="wizard-save-btn" onclick="wizardSave()" style="display:none;padding:8px 24px;background:rgba(249,115,22,.25);border:1px solid rgba(249,115,22,.5);color:#f97316;border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit;font-weight:700;letter-spacing:.5px">
        ENREGISTRER LE SITE
      </button>
    </div>

    <!-- Confirmation panel (shown after save) -->
    <div id="wizard-confirm-panel" style="display:none;margin-top:16px">
      <div class="card" style="border-color:rgba(249,115,22,.3)">
        <div style="font-size:13px;font-weight:700;color:#f97316;margin-bottom:12px">Site enregistré avec succès</div>
        <div id="wizard-confirm-summary" style="font-size:11px;color:var(--text2);line-height:1.8;margin-bottom:16px"></div>
        <div style="display:flex;gap:10px">
          <button onclick="launchOnboarding(false)" style="padding:8px 20px;background:rgba(249,115,22,.12);border:1px solid rgba(249,115,22,.3);color:#f97316;border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit">
            DRY-RUN (preview)
          </button>
          <button onclick="launchOnboarding(true)" style="padding:8px 20px;background:rgba(249,115,22,.25);border:1px solid rgba(249,115,22,.5);color:#f97316;border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit;font-weight:700">
            LANCER ONBOARDING COMPLET
          </button>
          <button onclick="resetWizard()" style="margin-left:auto;padding:8px 16px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);color:var(--text3);border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit">
            Nouveau site
          </button>
        </div>
        <div id="wizard-onboard-result" style="margin-top:12px;font-size:11px;color:var(--text3)"></div>
      </div>
    </div>

  </div>

  <!-- ═══ DASHBOARD LCR ═══ -->
  <div id="view-dashboard-lcr" style="display:none">
    <div id="sd-lcr-inner"><div style="color:var(--text3);padding:20px 0">Chargement...</div></div>
  </div>

  <!-- ═══ DASHBOARD MKD ═══ -->
  <div id="view-dashboard-mkd" style="display:none">
    <div id="sd-mkd-inner"><div style="color:var(--text3);padding:20px 0">Chargement...</div></div>
  </div>

  <!-- ═══ ANALYTICS (style Foudroyer) ═══ -->
  <div id="view-analytics" style="display:none">

    <!-- Header -->
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
      <span style="font-size:13px;font-weight:700;color:var(--blue)">Analytics SEO</span>
      <span id="analytics-sync-badge" class="tag tag-gray">chargement...</span>
      <div style="margin-left:auto;display:flex;gap:8px;align-items:center">
        <select id="analytics-site-select" onchange="loadAnalytics()"
          style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:var(--text1);border-radius:4px;padding:4px 8px;font-size:10px;font-family:inherit">
          <option value="lcr">LCR — leclientroi.com</option>
          <option value="mkd">MKD — mkdgroupe.com</option>
        </select>
      </div>
    </div>

    <!-- Score de santé SEO (style Foudroyer) -->
    <div style="display:grid;grid-template-columns:220px 1fr;gap:12px;margin-bottom:14px">
      <div class="card" style="text-align:center;position:relative">
        <div style="font-size:10px;color:var(--text3);letter-spacing:.5px;text-transform:uppercase;margin-bottom:8px">Score SEO Global</div>
        <div id="analytics-score-circle" style="width:90px;height:90px;border-radius:50%;margin:0 auto 8px;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:800;border:3px solid var(--blue)">—</div>
        <div id="analytics-score-label" style="font-size:11px;color:var(--text2);margin-bottom:8px">sur 100</div>
        <div style="font-size:9px;color:var(--text3)">DR + Indexation + Keywords + Trafic</div>
        <div style="margin-top:10px;display:flex;flex-direction:column;gap:3px" id="analytics-score-breakdown"></div>
      </div>
      <div>
        <!-- KPI cards row -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:8px">
          <div class="card"><div class="kpi-label">Domain Rating</div><div class="kpi-value" id="a-dr">—</div></div>
          <div class="card"><div class="kpi-label">Trafic organique</div><div class="kpi-value" id="a-traffic">—</div><div style="font-size:9px;color:var(--text3)">visites/mois (Ahrefs)</div></div>
          <div class="card"><div class="kpi-label">Keywords positionnés</div><div class="kpi-value" id="a-kw">—</div></div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
          <div class="card"><div class="kpi-label">Articles publiés</div><div class="kpi-value" id="a-published">—</div></div>
          <div class="card"><div class="kpi-label" style="color:var(--green)">Articles indexés</div><div class="kpi-value" style="color:var(--green)" id="a-indexed">—</div></div>
          <div class="card"><div class="kpi-label" style="color:var(--red)">Non indexés</div><div class="kpi-value" style="color:var(--red)" id="a-missing">—</div><div style="font-size:9px;color:var(--text3)">absents du sitemap</div></div>
        </div>
      </div>
    </div>

    <!-- Alertes prioritaires -->
    <div id="analytics-alerts" style="margin-bottom:14px"></div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">

      <!-- Keywords ranking -->
      <div class="card">
        <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--text2)">
          Keywords positionnés <span style="font-size:9px;color:var(--text3);font-weight:400">(source: Ahrefs)</span>
        </div>
        <table style="width:100%;border-collapse:collapse;font-size:11px">
          <thead><tr style="color:var(--text3);font-size:9px">
            <th style="text-align:left;padding:4px 6px">MOT-CLÉ</th>
            <th style="text-align:center;padding:4px 6px">POS</th>
            <th style="text-align:right;padding:4px 6px">VOL</th>
            <th style="text-align:center;padding:4px 6px">KD</th>
          </tr></thead>
          <tbody id="analytics-kw-tbody">
            <tr><td colspan="4" style="color:var(--text3);padding:8px">Chargement...</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Opportunités KD<30 -->
      <div class="card">
        <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--yellow)">
          Opportunités à saisir <span style="font-size:9px;color:var(--text3);font-weight:400">KD &lt; 30</span>
        </div>
        <table style="width:100%;border-collapse:collapse;font-size:11px">
          <thead><tr style="color:var(--text3);font-size:9px">
            <th style="text-align:left;padding:4px 6px">MOT-CLÉ</th>
            <th style="text-align:right;padding:4px 6px">VOL</th>
            <th style="text-align:center;padding:4px 6px">KD</th>
          </tr></thead>
          <tbody id="analytics-opps-tbody">
            <tr><td colspan="3" style="color:var(--text3);padding:8px">Chargement...</td></tr>
          </tbody>
        </table>
        <div style="margin-top:10px;font-size:11px;font-weight:700;color:var(--text2)">
          Mots-clés ciblés (vue SERP)
        </div>
        <table style="width:100%;border-collapse:collapse;font-size:11px;margin-top:6px">
          <thead><tr style="color:var(--text3);font-size:9px">
            <th style="text-align:left;padding:4px 6px">MOT-CLÉ</th>
            <th style="text-align:right;padding:4px 6px">VOL</th>
            <th style="text-align:center;padding:4px 6px">KD</th>
            <th style="text-align:center;padding:4px 6px">CPC</th>
          </tr></thead>
          <tbody id="analytics-kw-overview-tbody">
            <tr><td colspan="4" style="color:var(--text3);padding:4px">—</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">

      <!-- Top pages -->
      <div class="card">
        <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--text2)">Top pages <span style="font-size:9px;color:var(--text3);font-weight:400">(Ahrefs)</span></div>
        <div id="analytics-top-pages">
          <div style="color:var(--text3);font-size:11px">Chargement...</div>
        </div>
      </div>

      <!-- Concurrents -->
      <div class="card">
        <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--text2)">Concurrents organiques <span style="font-size:9px;color:var(--text3);font-weight:400">(Ahrefs)</span></div>
        <table style="width:100%;border-collapse:collapse;font-size:11px">
          <thead><tr style="color:var(--text3);font-size:9px">
            <th style="text-align:left;padding:4px 6px">DOMAINE</th>
            <th style="text-align:center;padding:4px 6px">DR</th>
            <th style="text-align:right;padding:4px 6px">TRAFIC</th>
          </tr></thead>
          <tbody id="analytics-comp-tbody">
            <tr><td colspan="3" style="color:var(--text3);padding:8px">Chargement...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- SERP #1 analysis -->
    <div class="card" style="margin-bottom:14px">
      <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--text2)">Analyse SERP — Qui est en position #1 sur vos mots-clés cibles</div>
      <div id="analytics-serp-top">
        <div style="color:var(--text3);font-size:11px">Chargement...</div>
      </div>
    </div>

    <!-- Non-indexed articles -->
    <div class="card" id="analytics-missing-panel" style="display:none">
      <div style="font-size:11px;font-weight:700;margin-bottom:10px;color:var(--red)">
        Articles publiés mais non indexés (Google ne les voit pas)
        <span id="analytics-missing-badge" class="tag tag-red" style="margin-left:8px">0</span>
      </div>
      <div id="analytics-missing-list" style="font-size:10px;color:var(--text2);line-height:2;max-height:200px;overflow-y:auto"></div>
      <div style="margin-top:10px;font-size:10px;color:var(--text3)">
        → Déployez les patches nginx (<code>dashboard/nginx-seo-patches.conf</code>) pour corriger le sitemap
      </div>
    </div>

  </div>

</main>

<script>
const API = '';  // même origine

// ── State ────────────────────────────────────────────────────────────────────
let state = { status: null, campaigns: null, articles: null, crm: null, system: null, budget: null, runs: null, _budgetActionFilter: '' };
let countdown = 10;
let currentView = 'overview';
let currentSite = '';
let _colorMenuSite = '';

// ── Sidebar site collapse/expand ──────────────────────────────────────────────
function toggleSiteNav(site, e) {
  // Don't intercept clicks on the ··· button
  if (e && e.target.closest('.site-menu-btn')) return;
  const label    = document.getElementById('site-label-' + site);
  const children = document.getElementById('nav-children-' + site);
  if (!label || !children) return;
  const collapsing = !children.classList.contains('nav-collapsed');
  children.classList.toggle('nav-collapsed', collapsing);
  label.classList.toggle('nav-collapsed', collapsing);
}

// ── Budget IA filter ──────────────────────────────────────────────────────────
let _iaFilter = 'all';

function setIAFilter(site) {
  _iaFilter = site;
  // Update button styles
  ['all','lcr','mkd'].forEach(s => {
    const btn = document.getElementById('ia-filter-' + s);
    if (btn) btn.className = 'tag ' + (s === site ? 'tag-cyan' : 'tag-gray');
  });
  // Re-render with current budget data
  const d = state.budget;
  if (d) renderBudgetIA(d);
}

function renderBudgetIA(d) {
  const tbody = document.getElementById('budget-ia-tbody');
  if (!tbody) return;

  // Provider definitions — extend this array to add new providers
  const PROVIDERS = [
    { key: 'anthropic', icon: '🤖', label: 'Anthropic',  color: 'var(--primary)',           match: m => m.startsWith('claude') },
    { key: 'deepseek',  icon: '🔵', label: 'DeepSeek',   color: 'var(--cyan)',               match: m => m.startsWith('deepseek') },
    { key: 'ahrefs',    icon: '📊', label: 'Ahrefs',     color: 'var(--green)',              match: m => m.startsWith('ahrefs') },
    { key: 'higgsfield',icon: '🎨', label: 'Higgsfield', color: '#fb923c',                   match: m => m.startsWith('higgsfield') },
    { key: 'other',     icon: '⚙',  label: 'Autres',     color: 'var(--muted-foreground)',   match: () => true },
  ];

  // Use raw entries to support site filtering
  const allEntries = d.week?.entries || [];
  const entries = _iaFilter === 'all' ? allEntries : allEntries.filter(e => e.site === _iaFilter);

  // Aggregate by provider
  const totals = { usd: 0, calls: 0 };
  const provData = {};
  PROVIDERS.forEach(p => { provData[p.key] = { usd: 0, calls: 0 }; });

  entries.forEach(e => {
    const mdl = e.model || '';
    const prov = PROVIDERS.find(p => p.match(mdl)) || PROVIDERS[PROVIDERS.length - 1];
    provData[prov.key].usd   += e.cost_usd  || 0;
    provData[prov.key].calls += 1;
    totals.usd   += e.cost_usd  || 0;
    totals.calls += 1;
  });

  const fmt = v => v < 0.001 ? '<$0.001' : '$' + v.toFixed(3);

  const rows = PROVIDERS.map(p => {
    const v = provData[p.key];
    if (v.calls === 0) return ''; // skip empty providers
    const monthEst = v.usd * 4.3;
    const yearEst  = v.usd * 52;
    return `<tr style="border-bottom:1px solid var(--border)">
      <td style="padding:9px 14px;border-right:1px solid var(--border)">
        <span style="font-size:14px;margin-right:6px">${p.icon}</span>
        <span style="font-weight:600;color:${p.color}">${p.label}</span>
      </td>
      <td style="padding:9px 10px;text-align:right;color:var(--muted-foreground);border-right:1px solid var(--border)">${v.calls}</td>
      <td style="padding:9px 10px;text-align:right;font-weight:600;color:var(--foreground);border-right:1px solid var(--border)">${fmt(v.usd)}</td>
      <td style="padding:9px 10px;text-align:right;color:var(--muted-foreground);border-right:1px solid var(--border)">~${fmt(monthEst)}</td>
      <td style="padding:9px 10px;text-align:right;color:var(--muted-foreground)">~${fmt(yearEst)}</td>
    </tr>`;
  }).filter(Boolean).join('');

  const monthTotal = totals.usd * 4.3;
  const yearTotal  = totals.usd * 52;
  const totalRow = `<tr style="border-top:2px solid var(--border);background:rgba(129,140,249,.05)">
    <td style="padding:9px 14px;border-right:1px solid var(--border)">
      <span style="font-weight:700;color:var(--foreground)">TOTAL</span>
      <span style="font-size:10px;color:var(--muted-foreground);margin-left:6px">${_iaFilter === 'all' ? 'tous sites' : _iaFilter.toUpperCase()}</span>
    </td>
    <td style="padding:9px 10px;text-align:right;font-weight:700;border-right:1px solid var(--border)">${totals.calls}</td>
    <td style="padding:9px 10px;text-align:right;font-weight:700;color:var(--yellow);border-right:1px solid var(--border)">${fmt(totals.usd)}</td>
    <td style="padding:9px 10px;text-align:right;font-weight:700;color:var(--yellow);border-right:1px solid var(--border)">~${fmt(monthTotal)}</td>
    <td style="padding:9px 10px;text-align:right;font-weight:700;color:var(--yellow)">~${fmt(yearTotal)}</td>
  </tr>`;

  tbody.innerHTML = (rows || '<tr><td colspan="5" style="padding:12px 14px;color:var(--muted-foreground)">Aucune donnée pour ce filtre</td></tr>') + totalRow;
}

// ── Site color picker ─────────────────────────────────────────────────────────
function openColorMenu(site, e) {
  e.stopPropagation();
  _colorMenuSite = site;
  const popup = document.getElementById('site-color-popup');
  const label = document.getElementById('site-color-popup-title');
  if (label) label.textContent = 'Couleur — ' + site.toUpperCase();
  const btn = e.currentTarget;
  const rect = btn.getBoundingClientRect();
  popup.style.top  = (rect.bottom + 6) + 'px';
  popup.style.left = Math.max(4, rect.left - 80) + 'px';
  popup.style.display = popup.style.display === 'block' ? 'none' : 'block';
}
function applyColorChoice(color) {
  if (!_colorMenuSite) return;
  localStorage.setItem('site-color-' + _colorMenuSite, color);
  applySiteColor(_colorMenuSite, color);
  document.getElementById('site-color-popup').style.display = 'none';
}
function applySiteColor(site, color) {
  const name = document.getElementById('site-name-' + site);
  const dot  = document.getElementById('site-dot-' + site);
  const label = document.getElementById('site-label-' + site);
  if (name)  name.style.color = color;
  if (dot)   dot.style.background = color;
  if (label) label.style.borderLeftColor = color;
}
// ── Theme toggle ──────────────────────────────────────────────────────────────
function toggleTheme() {
  const html = document.documentElement;
  const isDark = html.classList.toggle('dark');
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
  const btn = document.getElementById('theme-toggle-btn');
  if (btn) btn.textContent = isDark ? '🌙' : '☀️';
}
function applyStoredTheme() {
  const t = localStorage.getItem('theme') || 'dark';
  if (t === 'light') { document.documentElement.classList.remove('dark'); const btn = document.getElementById('theme-toggle-btn'); if (btn) btn.textContent = '☀️'; }
  else { document.documentElement.classList.add('dark'); }
}

function applySiteColors() {
  ['lcr','mkd'].forEach(s => {
    const c = localStorage.getItem('site-color-' + s);
    if (c) applySiteColor(s, c);
  });
}
document.addEventListener('click', () => {
  const p = document.getElementById('site-color-popup');
  if (p) p.style.display = 'none';
});

// ── Objectives (localStorage) ─────────────────────────────────────────────────
function saveObjectives(site) {
  const ta = document.getElementById('objectives-' + site);
  if (!ta) return;
  localStorage.setItem('objectives-' + site, ta.value);
  const btn = ta.closest('.card').querySelector('button');
  if (btn) { const orig = btn.textContent; btn.textContent = 'SAUVEGARDÉ ✓'; btn.style.color = 'var(--green)'; setTimeout(() => { btn.textContent = orig; btn.style.color = ''; }, 1500); }
}
function loadObjectives() {
  ['lcr','mkd'].forEach(s => {
    const ta = document.getElementById('objectives-' + s);
    if (ta) ta.value = localStorage.getItem('objectives-' + s) || '';
  });
}

// ── Per-site Dashboard ────────────────────────────────────────────────────────

const PROVIDER_COLORS = { claude:'#f97316', deepseek:'#06b6d4', ahrefs:'#8b5cf6', other:'#6b7280' };

async function loadSiteDashboard(site) {
  const inner = document.getElementById('sd-' + site + '-inner');
  if (!inner) return;
  inner.innerHTML = '<div style="color:var(--text3);font-size:11px;padding:12px 0">Chargement...</div>';

  let d;
  try {
    d = await apiFetch('/api/dashboard/' + site);
  } catch(e) {
    inner.innerHTML = '<div style="color:var(--red);font-size:11px">Erreur: ' + e.message + '</div>';
    return;
  }

  const siteColor   = site === 'lcr' ? 'var(--cyan)' : 'var(--green)';
  const siteLabel   = site === 'lcr' ? 'LCR — leclientroi.com' : 'MKD — mkdgroupe.com';
  const syncedAt    = d.checkedAt ? new Date(d.checkedAt).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) : '—';
  const seo         = d.seo || {};
  const idx         = d.indexation || {};
  const indexedOk   = (idx.published_count || 0) - (idx.missing_count || 0);

  // ── KPI strip ──────────────────────────────────────────────────────────────
  const kpiHtml = `
  <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:14px">
    <div class="card" style="border-color:${siteColor}33">
      <div class="kpi-label">Domain Rating</div>
      <div class="kpi-value" style="color:${siteColor}">${seo.dr || '—'}</div>
      <div style="font-size:9px;color:var(--text3)">Ahrefs DR</div>
    </div>
    <div class="card">
      <div class="kpi-label">Trafic organique</div>
      <div class="kpi-value">${(seo.traffic||0).toLocaleString('fr-FR')}</div>
      <div style="font-size:9px;color:var(--text3)">visites / mois</div>
    </div>
    <div class="card">
      <div class="kpi-label">Keywords positionnés</div>
      <div class="kpi-value">${seo.keywords || '—'}</div>
      <div style="font-size:9px;color:var(--text3)">source Ahrefs</div>
    </div>
    <div class="card">
      <div class="kpi-label">Articles publiés</div>
      <div class="kpi-value">${d.articles_count || '—'}</div>
      <div style="font-size:9px;color:var(--text3)">CMS</div>
    </div>
    <div class="card">
      <div class="kpi-label" style="color:${idx.missing_count>0?'var(--red)':'var(--green)'}">Indexation</div>
      <div class="kpi-value" style="color:${idx.missing_count>0?'var(--red)':'var(--green)'}">${indexedOk}/${idx.published_count||'—'}</div>
      <div style="font-size:9px;color:var(--text3)">${idx.missing_count||0} manquants sitemap</div>
    </div>
  </div>`;

  // ── Agent checklist ────────────────────────────────────────────────────────
  const checklist = d.checklist || [];
  const allOk = checklist.every(c => c.status === 'ok');
  const neverCount = checklist.filter(c => c.status === 'never').length;
  const overdueCount = checklist.filter(c => c.status === 'overdue').length;

  const checkRows = checklist.map(c => {
    const icon   = c.status === 'ok' ? '✓' : c.status === 'overdue' ? '⚠' : '✗';
    const clr    = c.status === 'ok' ? 'var(--green)' : c.status === 'overdue' ? 'var(--yellow)' : 'var(--red)';
    const since  = c.hours_since != null
      ? (c.hours_since < 24 ? 'il y a ' + Math.round(c.hours_since) + 'h' : 'il y a ' + Math.round(c.hours_since/24) + 'j')
      : '—';
    const pm2Tag = c.pm2_status === 'online'
      ? `<span style="font-size:8px;padding:1px 5px;border-radius:3px;background:rgba(34,197,94,.12);color:var(--green);border:1px solid rgba(34,197,94,.2)">pm2 online</span>`
      : c.pm2_status
        ? `<span style="font-size:8px;padding:1px 5px;border-radius:3px;background:rgba(239,68,68,.08);color:var(--red);border:1px solid rgba(239,68,68,.2)">pm2 ${c.pm2_status}</span>`
        : '';
    const statusTag = `<span style="font-size:9px;font-weight:700;color:${clr}">${c.status === 'ok' ? 'OK' : c.status === 'overdue' ? 'EN RETARD' : 'JAMAIS'}</span>`;
    return `<tr style="border-top:1px solid var(--border)">
      <td style="padding:7px 10px;font-size:13px;color:${clr};width:20px">${icon}</td>
      <td style="padding:7px 6px;font-size:11px;color:var(--text1);font-weight:600">${c.label}</td>
      <td style="padding:7px 6px;font-size:10px;color:var(--text3)">${c.cron}</td>
      <td style="padding:7px 6px;font-size:10px;color:var(--text2)">${since}</td>
      <td style="padding:7px 6px;display:flex;align-items:center;gap:6px">${statusTag} ${pm2Tag}</td>
    </tr>`;
  }).join('');

  const checklistHtml = `
  <div class="table-card" style="margin-bottom:14px">
    <div class="table-card-header">
      <span class="table-card-title">Agents Genesis — checklist</span>
      <span class="tag ${allOk?'tag-green':overdueCount>0?'tag-yellow':'tag-red'}">${allOk?'Tous OK':overdueCount+' en retard · '+neverCount+' jamais'}</span>
    </div>
    <table style="width:100%">
      <thead><tr style="color:var(--text3);font-size:9px">
        <th style="padding:5px 10px;text-align:left"></th>
        <th style="padding:5px 6px;text-align:left">AGENT</th>
        <th style="padding:5px 6px;text-align:left">SCHEDULE</th>
        <th style="padding:5px 6px;text-align:left">DERNIER RUN</th>
        <th style="padding:5px 6px;text-align:left">STATUT</th>
      </tr></thead>
      <tbody>${checkRows}</tbody>
    </table>
  </div>`;

  // ── Costs by provider ──────────────────────────────────────────────────────
  const mc = d.month_costs || {};
  const yc = d.year_costs  || {};
  const providers = ['claude','deepseek','ahrefs','other'];

  const totalMonth = providers.reduce((s,k) => s + (mc[k]?.usd||0), 0);
  const totalYear  = providers.reduce((s,k) => s + (yc[k]?.usd||0), 0);

  const costRows = providers.map(k => {
    const mv = mc[k] || {}; const yv = yc[k] || {};
    if (!mv.usd && !yv.usd) return '';
    const dot = `<span style="width:8px;height:8px;border-radius:50%;background:${PROVIDER_COLORS[k]||'#888'};display:inline-block;margin-right:8px;flex-shrink:0"></span>`;
    return `<tr style="border-top:1px solid var(--border)">
      <td style="padding:7px 10px;white-space:nowrap">${dot}<span style="font-size:11px;color:var(--text1)">${mv.label||k}</span></td>
      <td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:var(--yellow)">$${mv.usd.toFixed(2)}</td>
      <td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:var(--text2)">$${yv.usd.toFixed(2)}</td>
    </tr>`;
  }).join('');

  const costsHtml = `
  <div class="table-card" style="margin-bottom:14px">
    <div class="table-card-header">
      <span class="table-card-title">Budget IA — ${siteLabel.split('—')[0].trim()}</span>
      <span style="font-size:9px;color:var(--text3)">Ahrefs = forfait mensuel estimé · Claude/DeepSeek = réel</span>
    </div>
    <table style="width:100%">
      <thead><tr style="color:var(--text3);font-size:9px">
        <th style="padding:5px 10px;text-align:left">OUTIL / IA</th>
        <th style="padding:5px 10px;text-align:right">CE MOIS</th>
        <th style="padding:5px 10px;text-align:right">ANNUEL (estimé)</th>
      </tr></thead>
      <tbody>
        ${costRows}
        <tr style="border-top:2px solid var(--border)">
          <td style="padding:8px 10px;font-size:11px;font-weight:700;color:var(--text2)">TOTAL</td>
          <td style="padding:8px 10px;text-align:right;font-size:13px;font-weight:800;color:var(--yellow)">$${totalMonth.toFixed(2)}</td>
          <td style="padding:8px 10px;text-align:right;font-size:13px;font-weight:800;color:var(--text1)">$${totalYear.toFixed(2)}</td>
        </tr>
      </tbody>
    </table>
  </div>`;

  // ── Header ─────────────────────────────────────────────────────────────────
  const header = `
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
    <span style="font-size:14px;font-weight:800;color:${siteColor}">${siteLabel}</span>
    <span style="font-size:9px;color:var(--text3)">actualisé à ${syncedAt}</span>
    <button onclick="state['dashboard-${site}']=null;loadSiteDashboard('${site}')" style="margin-left:auto;background:rgba(255,255,255,.05);border:1px solid var(--border);color:var(--text3);border-radius:4px;padding:3px 9px;cursor:pointer;font-size:9px;font-family:inherit">↺ Rafraîchir</button>
  </div>`;

  inner.innerHTML = header + kpiHtml + checklistHtml + costsHtml;
}

// ── Connectors & Module availability ─────────────────────────────────────────

const SITE_MODULE_DEFS = {
  lcr: [
    { id:'content',     label:'content_agent', color:'cyan',  desc:'Articles Emdash depuis backlog',            schedule:'1/semaine',      requires:['emdash','deepseek'] },
    { id:'briefing',    label:'briefing',      color:'cyan',  desc:'Stats Emelia + rapport Telegram',           schedule:'07:00 UTC / j',   requires:['telegram','emelia'] },
    { id:'seo',         label:'seo',           color:'cyan',  desc:'Analyse Ahrefs + rank tracker',             schedule:'lun 06:00 UTC',   requires:['ahrefs'] },
    { id:'indexation',  label:'indexation',    color:'cyan',  desc:'Audit sitemap + soumission IndexNow',       schedule:'lun 06:30 UTC',   requires:['emdash'] },
    { id:'infographic', label:'infographic',   color:'cyan',  desc:'Schémas PNG Pillow → Emdash',               schedule:'par article',     requires:['emdash'] },
    { id:'newsletter',  label:'newsletter',    color:'cyan',  desc:'Génération HTML + envoi Resend',            schedule:'mensuel',         requires:['resend','emdash'] },
  ],
  mkd: [
    { id:'content',   label:'content_agent', color:'green', desc:'Veille RSS + rédaction WordPress',           schedule:'1/semaine',      requires:['wordpress','deepseek'] },
    { id:'crm_sync',  label:'crm_sync',      color:'green', desc:'Sync réponses Emelia → Twenty CRM',          schedule:'08:00 UTC lun-v', requires:['emelia','twenty'] },
    { id:'campaigns', label:'campaigns',     color:'green', desc:'Cold email B2B — 79K prospects CSV',         schedule:'09:00 UTC lun',   requires:['emelia'] },
    { id:'seo',       label:'seo',           color:'green', desc:'Analyse Ahrefs + rank tracker',              schedule:'lun 06:00 UTC',   requires:['ahrefs'] },
    { id:'briefing',  label:'briefing',      color:'green', desc:'Stats + rapport Telegram',                   schedule:'07:00 UTC / j',   requires:['telegram'] },
  ],
};

let _connectors = null;

async function loadConnectors() {
  if (_connectors) return _connectors;
  try {
    const d = await apiFetch('/api/connectors');
    _connectors = d.connectors || {};
  } catch(e) {
    _connectors = {};
  }
  return _connectors;
}

async function renderModules(site) {
  const connectors = await loadConnectors();
  const defs = SITE_MODULE_DEFS[site] || [];
  const grid = document.getElementById(site + '-modules-grid');
  const statusEl = document.getElementById(site + '-modules-status');
  if (!grid) return;

  let availCount = 0;
  let html = '';
  for (const m of defs) {
    const reqStatuses = m.requires.map(r => ({ key: r, ok: connectors[r]?.ok ?? false, label: connectors[r]?.label || r }));
    const allOk = reqStatuses.every(r => r.ok);
    if (allOk) availCount++;

    const chips = reqStatuses.map(r =>
      `<span class="req-chip ${r.ok ? 'ok' : 'nok'}" title="${connectors[r.key]?.env_var || r.key}">${r.key}</span>`
    ).join('');

    const tagColor = m.color === 'green' ? 'tag-green' : 'tag-cyan';
    const configBtn = !allOk
      ? `<button class="btn-configure" onclick="openConfigPanel('${site}','${m.id}')">CONFIGURER</button>`
      : '';

    html += `<div class="module-card ${allOk ? '' : 'unavailable'}">
      <div class="module-card-left">
        <div class="module-card-name"><span class="tag ${tagColor}" style="margin-right:6px">${m.label}</span>${m.desc}</div>
        <div class="module-card-reqs">${chips}</div>
      </div>
      <div class="module-card-right">
        <span class="module-schedule">${m.schedule}</span>
        ${configBtn}
      </div>
    </div>`;
  }

  grid.innerHTML = html || '<div style="color:var(--text3);font-size:11px;padding:8px 0">Aucun module défini.</div>';
  if (statusEl) {
    statusEl.textContent = availCount + '/' + defs.length + ' disponibles';
    statusEl.style.color = availCount === defs.length ? 'var(--green)' : availCount === 0 ? 'var(--red)' : 'var(--yellow)';
  }
}

function openConfigPanel(site, moduleId) {
  const m = (SITE_MODULE_DEFS[site] || []).find(x => x.id === moduleId);
  if (!m) return;
  const missing = m.requires.filter(r => !(_connectors[r]?.ok));
  const lines = missing.map(r => {
    const c = _connectors[r] || {};
    return `<div style="margin:6px 0;padding:10px 12px;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.22);border-radius:6px">
      <div style="font-size:11px;font-weight:600;color:var(--red)">⚠ ${c.label || r}</div>
      <div style="font-size:9px;color:var(--text3);margin-top:4px">Ajouter dans <code style="color:var(--text2)">.env</code> : <code style="color:var(--yellow)">${c.env_var || r.toUpperCase()}</code></div>
    </div>`;
  }).join('');

  // Afficher le panneau de config flottant
  let panel = document.getElementById('config-panel-overlay');
  if (!panel) {
    panel = document.createElement('div');
    panel.id = 'config-panel-overlay';
    panel.style.cssText = 'position:fixed;inset:0;z-index:9000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);backdrop-filter:blur(2px)';
    panel.onclick = e => { if (e.target === panel) panel.remove(); };
    document.body.appendChild(panel);
  }
  panel.innerHTML = `<div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:24px;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.5)">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div style="font-size:13px;font-weight:700">Configurer <code style="color:var(--${m.color === 'green' ? 'green' : 'cyan'})">${m.label}</code></div>
      <button onclick="document.getElementById('config-panel-overlay').remove()" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:16px;padding:2px 6px">✕</button>
    </div>
    <div style="font-size:10px;color:var(--text3);margin-bottom:12px">Connecteurs manquants pour activer ce module :</div>
    ${lines}
    <div style="margin-top:16px;font-size:9px;color:var(--text3);line-height:1.6">
      Éditez <code style="color:var(--text2)">/home/autoblog/genesis/.env</code> puis redémarrez le dashboard :<br>
      <code style="color:var(--yellow)">pm2 restart genesis-dashboard</code>
    </div>
    <button onclick="document.getElementById('config-panel-overlay').remove();_connectors=null;renderModules('${site}')" style="margin-top:14px;width:100%;padding:8px;background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:6px;color:var(--text2);cursor:pointer;font-size:10px;font-family:inherit">Rafraîchir après configuration</button>
  </div>`;
}

// ── Clock ────────────────────────────────────────────────────────────────────
function tick() {
  const n = new Date();
  document.getElementById('clock').textContent =
    [n.getUTCHours(), n.getUTCMinutes(), n.getUTCSeconds()]
    .map(x => String(x).padStart(2,'0')).join(':') + ' UTC';
  countdown--;
  document.getElementById('refresh-countdown').textContent = countdown + 's';
  if (countdown <= 0) { countdown = 10; refreshAll(); }
}
setInterval(tick, 1000);

// ── Navigation ───────────────────────────────────────────────────────────────
function showSiteView(site, view) {
  // Changer le contexte site si besoin
  if (site !== currentSite) {
    currentSite = site;
    state.budget = null;
    state.articles = null;
  }
  // Indicateur topbar
  const ctx = document.getElementById('topbar-site-ctx');
  if (ctx) {
    if (site === 'lcr') { ctx.style.display = ''; ctx.style.background = 'rgba(6,182,212,.12)'; ctx.style.color = 'var(--cyan)'; ctx.style.border = '1px solid rgba(6,182,212,.3)'; ctx.textContent = 'LCR'; }
    else if (site === 'mkd') { ctx.style.display = ''; ctx.style.background = 'rgba(34,197,94,.12)'; ctx.style.color = 'var(--green)'; ctx.style.border = '1px solid rgba(34,197,94,.3)'; ctx.textContent = 'MKD'; }
    else { ctx.style.display = 'none'; }
  }
  // Active states sidebar
  document.querySelectorAll('.nav-item, .nav-child').forEach(el => el.classList.remove('active'));
  if (site) {
    document.querySelectorAll(`.nav-child[data-site="${site}"][data-view="${view}"]`).forEach(el => el.classList.add('active'));
  } else {
    document.querySelectorAll(`.nav-item[onclick*="showSiteView('','${view}')"]`).forEach(el => el.classList.add('active'));
  }
  // Charger selon la vue
  if (view === 'dashboard-lcr') loadSiteDashboard('lcr');
  else if (view === 'dashboard-mkd') loadSiteDashboard('mkd');
  else if (view === 'site-lcr') renderModules('lcr');
  else if (view === 'site-mkd') renderModules('mkd');
  // Afficher la vue
  showView(view);
}

function showView(name) {
  currentView = name;
  location.hash = name;
  document.querySelectorAll('#main > div').forEach(d => d.style.display = 'none');
  const el = document.getElementById('view-' + name);
  if (el) el.style.display = '';
  // Charger les données de la vue
  if (name === 'overview')  { loadOverview(); startMindMap(); }
  if (name === 'campaigns') loadCampaigns();
  if (name === 'articles')  loadArticles();
  if (name === 'crm'     && !state.crm)     loadCRM();
  if (name === 'site-lcr') loadSite('lcr');
  if (name === 'site-mkd') loadSite('mkd');
  if (name === 'services' && !state.services) loadServices();
  if (name === 'system'   && !state.system)   loadSystem();
  if (name === 'budget')   loadBudget();
  if (name === 'runs')     loadRuns();
  if (name === 'seo')      loadSEO();
  if (name === 'indexation') loadIndexation();
  if (name === 'onboarding') loadOnboarding();
  if (name === 'analytics')  loadAnalytics();
}

// ── Fetch helpers ─────────────────────────────────────────────────────────────
async function apiFetch(endpoint) {
  const sep = endpoint.includes('?') ? '&' : '?';
  const r = await fetch(API + endpoint + sep + 't=' + Date.now());
  if (!r.ok) throw new Error('HTTP ' + r.status);
  return r.json();
}

// ── Format helpers ────────────────────────────────────────────────────────────
function fmtDate(iso) {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('fr-FR', {day:'2-digit',month:'2-digit'}) + ' ' +
         d.toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});
}
function fmtDur(s) {
  if (s == null) return '—';
  return s < 60 ? s + 's' : Math.round(s/60) + 'min';
}
function fmtCents(c) {
  return c == null ? '—' : (c / 100).toFixed(2) + ' $';
}
function statusTag(s) {
  if (s === 'success' || s === 'published' || s === 'online')
    return `<span class="tag tag-green">${s.toUpperCase()}</span>`;
  if (s === 'error' || s === 'errored' || s === 'failed')
    return `<span class="tag tag-red">${s.toUpperCase()}</span>`;
  if (s === 'draft' || s === 'stopped')
    return `<span class="tag tag-gray">${s.toUpperCase()}</span>`;
  return `<span class="tag tag-orange">${s.toUpperCase()}</span>`;
}

// ── Load /api/status (overview) ───────────────────────────────────────────────
async function loadStatus() {
  try {
    const d = await apiFetch('/api/status');
    state.status = d;

    // KPIs (null-guarded — elements may not exist in all views)
    const elRuns = document.getElementById('kpi-runs');
    const elRunsSub = document.getElementById('kpi-runs-sub');
    if (elRuns) elRuns.textContent = d.runCount || 0;
    if (elRunsSub) elRunsSub.textContent = 'total depuis installation';

    const lr = d.lastRuns || {};
    // Modules
    ['briefing','content','crm_sync'].forEach(mod => {
      const key = mod.replace('_sync','');
      const run = lr[mod] || lr[key];
      if (!run) return;
      const el = document.getElementById('mod-' + key + '-status');
      const el2 = document.getElementById('mod-' + key + '-last');
      if (el) {
        el.textContent = run.status === 'success' ? 'OK' : 'ERR';
        el.className = 'tag ' + (run.status === 'success' ? 'tag-green' : 'tag-red');
      }
      if (el2) el2.textContent = 'Dernier : ' + fmtDate(run.date);
    });

    // Derniers runs (overview)
    const runs = d.recentRuns || [];
    const tb = document.getElementById('runs-overview-tbody');
    if (tb) tb.innerHTML = runs.length ? runs.slice().reverse().map(r => `
      <tr>
        <td class="run-module">${r.module || '—'}</td>
        <td style="color:var(--text2)">${r.task || '—'}</td>
        <td>${statusTag(r.status)}</td>
        <td class="run-time">${fmtDur(r.duration)}</td>
      </tr>`).join('') : '<tr><td colspan="4" style="color:var(--text3)">Aucun run</td></tr>';

    const lu = document.getElementById('last-update-badge');
    if (lu && d.meta?.lastUpdate) lu.textContent = fmtDate(d.meta.lastUpdate);

    document.getElementById('loading-overlay').classList.add('hidden');
  } catch(e) {
    console.error('status:', e);
    document.getElementById('loading-overlay').querySelector('div:last-child').textContent = 'API hors ligne — relancer scripts/api.py';
  }
}

// ── Cold Email tabs ────────────────────────────────────────────────────────────
let ceChart = null;
function ceTab(name) {
  ['overview','sources','search','export'].forEach(t => {
    document.getElementById('ce-view-'+t).style.display = t===name ? '' : 'none';
    const btn = document.getElementById('cetab-'+t);
    btn.className = t===name ? 'tag tag-cyan' : 'tag tag-gray';
    btn.style.cursor = 'pointer';
  });
}

async function loadCampaigns() {
  // Cold email stats
  try {
    const d = await apiFetch('/api/cold-email/overview');
    document.getElementById('ce-total').textContent = d.totals.total;
    document.getElementById('ce-ok').textContent    = d.totals.ok;
    document.getElementById('ce-rej').textContent   = d.totals.rejected;
    document.getElementById('ce-drop').textContent  = d.totals.dropped;
    document.getElementById('ce-err').textContent   = d.totals.error;

    // Graphique mensuel
    const months = Object.keys(d.monthly || {});
    const vals   = months.map(m => d.monthly[m].total || 0);
    if (ceChart) ceChart.destroy();
    const ctx = document.getElementById('ce-chart-monthly');
    if (ctx) ceChart = new Chart(ctx, {type:'bar',
      data:{labels:months, datasets:[{label:'Envois',data:vals,backgroundColor:'rgba(6,182,212,.6)'}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},
               scales:{x:{ticks:{color:'#888'}},y:{ticks:{color:'#888'}}}}});

    // Tableau par source
    const src = d.sources || {};
    const sel = document.getElementById('ce-src-select');
    sel.innerHTML = '';
    const tbody = document.getElementById('ce-sources-tbody');
    tbody.innerHTML = '';
    for (const [name, s] of Object.entries(src)) {
      tbody.insertAdjacentHTML('beforeend',`<tr style="border-top:1px solid rgba(255,255,255,.05);cursor:pointer" onclick="ceTab('sources');document.getElementById('ce-src-select').value='${name}';loadCESource('${name}')">
        <td style="padding:4px 8px;color:var(--text2)">${name}</td>
        <td style="padding:4px 8px;text-align:right">${s.total}</td>
        <td style="padding:4px 8px;text-align:right;color:var(--green)">${s.ok}</td>
        <td style="padding:4px 8px;text-align:right;color:var(--red)">${s.rejected}</td>
        <td style="padding:4px 8px;text-align:right;color:var(--yellow)">${s.dropped}</td>
        <td style="padding:4px 8px;text-align:right;color:var(--orange)">${s.error||0}</td>
      </tr>`);
      sel.insertAdjacentHTML('beforeend',`<option value="${name}">${name}</option>`);
    }
    if (!Object.keys(src).length) tbody.innerHTML = '<tr><td colspan="6" style="padding:8px;color:var(--text3)">Aucun envoi pour l\'instant</td></tr>';

    document.getElementById('nav-campaigns-count').textContent = d.totals.total || '0';
    document.getElementById('kpi-campaigns').textContent = d.totals.ok || 0;
    document.getElementById('kpi-campaigns-sub').textContent = d.totals.total + ' contacts traités';
  } catch(e) { console.error('cold-email overview:', e); }

  // Campagnes Emelia actives
  try {
    const d = await apiFetch('/api/campaigns');
    const c = d.campaigns || [];
    const body = document.getElementById('campaigns-body');
    body.innerHTML = c.length ? c.map(camp => `
      <div class="campaign-item">
        <div class="nav-dot" style="background:${camp.status==='ACTIVE'?'var(--green)':'var(--text3)'}"></div>
        <div class="campaign-name">${camp.name}<br>
          <span style="color:var(--text3);font-size:9px">${camp.status} · créée ${fmtDate(camp.createdAt)}</span>
        </div>
        <div class="campaign-stat"><div class="val" style="color:var(--cyan)">${camp.total||0}</div><div class="lbl">contacts</div></div>
        <div class="campaign-stat"><div class="val" style="color:var(--green)">${camp.replyRate||0}%</div><div class="lbl">réponses</div></div>
        <div class="campaign-stat"><div class="val" style="color:${(camp.bounceRate||0)>5?'var(--red)':'var(--text2)'}">${camp.bounceRate||0}%</div><div class="lbl">bounces</div></div>
      </div>`).join('') : '<div style="padding:12px;color:var(--text3);font-size:11px">Aucune campagne Emelia active</div>';
  } catch(e) { console.error('campaigns emelia:', e); }
}

async function loadCESource(name) {
  if (!name) return;
  const d = await apiFetch('/api/cold-email/tab/' + encodeURIComponent(name));
  const days = Object.keys(d.by_day || {}).sort().reverse();
  let h = `<p style="font-size:11px;margin-bottom:10px">Total: <b>${d.stats.total}</b> &bull;
    OK: <span style="color:var(--green)">${d.stats.ok}</span> &bull;
    Rejet: <span style="color:var(--red)">${d.stats.rejected}</span> &bull;
    Drop: <span style="color:var(--yellow)">${d.stats.dropped}</span></p>
    <table style="width:100%;border-collapse:collapse;font-size:11px">
    <thead><tr style="color:var(--text3);text-align:left">
      <th style="padding:4px 8px">Jour</th><th style="padding:4px 8px;text-align:right">Envoyés</th>
      <th style="padding:4px 8px;text-align:right;color:var(--green)">OK</th>
      <th style="padding:4px 8px;text-align:right;color:var(--red)">Rejet</th>
      <th style="padding:4px 8px;text-align:right;color:var(--yellow)">Drop</th>
    </tr></thead><tbody>`;
  for (const day of days.slice(0,60)) {
    const x = d.by_day[day];
    h += `<tr style="border-top:1px solid rgba(255,255,255,.05)">
      <td style="padding:4px 8px">${day}</td>
      <td style="padding:4px 8px;text-align:right">${x.sent}</td>
      <td style="padding:4px 8px;text-align:right;color:var(--green)">${x.ok}</td>
      <td style="padding:4px 8px;text-align:right;color:var(--red)">${x.rejected}</td>
      <td style="padding:4px 8px;text-align:right;color:var(--yellow)">${x.dropped}</td>
    </tr>`;
  }
  h += '</tbody></table>';
  document.getElementById('ce-src-detail').innerHTML = h;
}

async function doCESearch() {
  const q = document.getElementById('ce-search-input').value.trim();
  if (q.length < 4) { document.getElementById('ce-search-results').textContent = 'Saisis au moins 4 caractères.'; return; }
  const d = await apiFetch('/api/cold-email/search?q=' + encodeURIComponent(q));
  if (!d.count) { document.getElementById('ce-search-results').innerHTML = '<span style="color:var(--text3)">Aucun résultat.</span>'; return; }
  document.getElementById('ce-search-results').innerHTML = `<p style="margin-bottom:8px"><b>${d.count}</b> résultat(s)</p>` +
    d.results.map(r => `<div style="background:rgba(255,255,255,.03);border-radius:4px;padding:8px;margin-bottom:6px;font-family:monospace;font-size:10px;white-space:pre-wrap">${JSON.stringify(r,null,2)}</div>`).join('');
}

function doCEExport() {
  const f = document.getElementById('ce-exp-from').value.trim();
  const t = document.getElementById('ce-exp-to').value.trim();
  if (!f || !t) { alert('Renseigne les 2 dates'); return; }
  window.location.href = API + `/api/cold-email/export?from_date=${encodeURIComponent(f)}&to_date=${encodeURIComponent(t)}`;
}

// ── Load /api/articles ────────────────────────────────────────────────────────
async function loadArticles() {
  try {
    const d = await apiFetch('/api/articles');
    state.articles = d;
    let a = (d.articles || []).filter(x => !x.error);
    const total = a.length;
    // Filtrer par site si contexte actif
    if (currentSite) a = a.filter(x => x.site.toLowerCase() === currentSite);
    document.getElementById('nav-articles-count').textContent = total;
    document.getElementById('kpi-articles').textContent = total;
    const badge = document.getElementById('articles-site-badge');
    if (badge) { badge.textContent = currentSite ? currentSite.toUpperCase() + ' — ' + a.length + ' articles' : total + ' articles'; badge.className = currentSite === 'lcr' ? 'tag tag-cyan' : currentSite === 'mkd' ? 'tag tag-green' : 'tag tag-gray'; }

    // Récupérer les coûts content pour matcher par date approximative
    const costMap = {}; // simpliste : on n'a pas encore de lien direct article↔coût
    // Les colonnes indexation sont préparées pour une feature future (toujours '—')
    const idxIcon = '<span style="color:var(--text3);font-size:9px">—</span>';

    const tb = document.getElementById('articles-tbody');
    tb.innerHTML = a.length ? a.map(art => `
      <tr>
        <td><span class="tag ${art.site==='LCR'?'tag-cyan':'tag-green'}">${art.site}</span></td>
        <td style="color:var(--text);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${art.title}">${art.title}</td>
        <td>${statusTag(art.status)}</td>
        <td class="run-time">${fmtDate(art.date)}</td>
        <td style="color:var(--yellow);font-size:10px" title="Coût de génération — à connecter">—</td>
        <td style="text-align:center">${idxIcon}</td>
        <td style="text-align:center">${idxIcon}</td>
        <td style="text-align:center">${idxIcon}</td>
        <td><a href="${art.url}" target="_blank" style="color:var(--blue);text-decoration:none;font-size:10px">↗</a></td>
      </tr>`).join('') : '<tr><td colspan="9" style="color:var(--text3)">Aucun article</td></tr>';
  } catch(e) { console.error('articles:', e); }
}

// ── Load /api/crm ─────────────────────────────────────────────────────────────
async function loadCRM() {
  try {
    const d = await apiFetch('/api/crm');
    state.crm = d;
    document.getElementById('nav-crm-count').textContent = d.total || 0;
    document.getElementById('crm-total').textContent = d.total || 0;
    document.getElementById('crm-synced').textContent = d.synced || 0;

    const tb = document.getElementById('crm-tbody');
    const contacts = d.contacts || [];
    tb.innerHTML = contacts.length ? contacts.map(c => `
      <tr>
        <td style="color:var(--text)">${(c.name?.firstName || '') + ' ' + (c.name?.lastName || '')}</td>
        <td>${c.jobTitle || '—'}</td>
      </tr>`).join('') : '<tr><td colspan="2" style="color:var(--text3)">Aucun contact</td></tr>';
  } catch(e) { console.error('crm:', e); }
}

// ── Load /api/runs ────────────────────────────────────────────────────────────
async function loadRuns() {
  try {
    const d = await apiFetch('/api/runs');
    state.runs = d;
    document.getElementById('runs-total-badge').textContent = d.total + ' runs';
    const tb = document.getElementById('runs-full-tbody');
    const runs = (d.runs || []).slice().reverse();
    tb.innerHTML = runs.length ? runs.map(r => `
      <tr>
        <td class="run-time td-mono">${fmtDate(r.date)}</td>
        <td class="run-module">${r.module || '—'}</td>
        <td style="color:var(--text2)">${r.task || '—'}</td>
        <td>${statusTag(r.status)}</td>
        <td class="run-time">${fmtDur(r.duration)}</td>
      </tr>`).join('') : '<tr><td colspan="5" style="color:var(--text3)">Aucun run</td></tr>';
  } catch(e) { console.error('runs:', e); }
}

// ── Load /api/site ────────────────────────────────────────────────────────────
async function loadSite(site) {
  try {
    const d = await apiFetch('/api/site/' + site);
    const color = site === 'lcr' ? 'var(--cyan)' : 'var(--green)';
    const articles = (d.articles || []).filter(a => !a.error);

    // KPIs
    document.getElementById(site + '-articles-count').textContent = articles.length;
    document.getElementById(site + '-cost').textContent = fmtEur(d.costEur);

    // Articles table
    document.getElementById(site + '-articles-tbody').innerHTML =
      articles.length ? articles.map(a => `
        <tr>
          <td style="color:var(--text);max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${a.title || a.slug}</td>
          <td>${statusTag(a.status)}</td>
          <td class="run-time">${fmtDate(a.date)}</td>
          <td><a href="${a.url}" target="_blank" style="color:${color};text-decoration:none">↗</a></td>
        </tr>`).join('')
      : '<tr><td colspan="4" style="color:var(--text3)">Aucun article</td></tr>';

    // Runs
    const runs = (d.runs || []).slice().reverse();
    const costMap = {};
    (d.costEntries || []).forEach(e => {
      costMap[e.action] = e;
    });

    document.getElementById(site + '-runs-tbody').innerHTML =
      runs.length ? runs.map(r => {
        const ce = costMap[r.action] || {};
        return `<tr>
          <td class="run-time td-mono">${fmtDate(r.date)}</td>
          <td style="color:var(--text2)">${r.task || r.action || '—'}</td>
          <td>${statusTag(r.status)}</td>
          <td style="color:var(--text3)">${ce.total_tok ? fmtTok(ce.total_tok) : '—'}</td>
          <td style="color:var(--yellow)">${ce.cost_eur ? fmtEur(ce.cost_eur) : '—'}</td>
        </tr>`;
      }).join('')
      : '<tr><td colspan="5" style="color:var(--text3)">Aucun run enregistré</td></tr>';

    // Badges topbar LCR/MKD
    const badge = document.getElementById(site === 'lcr' ? 'lcr-badge' : 'mkd-badge');
    if (badge) {
      badge.textContent = articles.length + ' articles';
      badge.className = 'tag ' + (site === 'lcr' ? 'tag-cyan' : 'tag-green');
    }
  } catch(e) { console.error('site ' + site, e); }
}

// ── Load /api/services ───────────────────────────────────────────────────────
async function loadServices() {
  try {
    const d = await apiFetch('/api/services');
    state.services = d;
    const svcs = d.services || [];

    // KPIs
    const online    = svcs.filter(s => s.type === 'service' && s.displayStatus === 'online').length;
    const svcTotal  = svcs.filter(s => s.type === 'service').length;
    const cronsOk   = svcs.filter(s => s.type === 'cron' && s.displayStatus === 'ok').length;
    const cronTotal = svcs.filter(s => s.type === 'cron').length;
    const alerts    = (d.alerts || []).length;
    const overdue   = svcs.filter(s => s.overdue).length;

    document.getElementById('svc-online').textContent    = online + ' / ' + svcTotal;
    document.getElementById('svc-crons-ok').textContent  = cronsOk + ' / ' + cronTotal;
    document.getElementById('svc-alerts').textContent    = alerts;
    document.getElementById('services-checked-at').textContent = 'Vérifié à ' + fmtDate(d.checkedAt);

    // Badge sidebar
    const navBadge = document.getElementById('nav-services-badge');
    if (overdue > 0) {
      navBadge.textContent = overdue + ' alerte' + (overdue > 1 ? 's' : '');
      navBadge.className = 'status-badge tag tag-red';
    } else {
      navBadge.textContent = 'OK';
      navBadge.className = 'status-badge tag tag-green';
    }

    // Cartes services
    const grid = document.getElementById('services-grid');
    grid.innerHTML = svcs.map(s => {
      const isOverdue  = s.overdue;
      const borderColor = isOverdue ? 'var(--red)' : s.displayStatus === 'online' || s.displayStatus === 'ok' ? 'var(--border)' : 'var(--border)';
      const bgColor     = isOverdue ? 'rgba(239,68,68,0.06)' : 'var(--card)';

      let statusHtml;
      if (s.type === 'service') {
        statusHtml = s.displayStatus === 'online'
          ? `<span class="tag tag-green">ONLINE</span>`
          : `<span class="tag tag-red">OFFLINE</span>`;
      } else {
        const map = {
          ok:      `<span class="tag tag-green">OK</span>`,
          overdue: `<span class="tag tag-red">EN RETARD</span>`,
          never:   `<span class="tag tag-gray">JAMAIS</span>`,
        };
        statusHtml = map[s.displayStatus] || `<span class="tag tag-gray">${s.displayStatus}</span>`;
      }

      let lastRunHtml = '—';
      if (s.lastRunDate) {
        const hoursColor = s.overdue ? 'var(--red)' : s.hoursSince > 12 ? 'var(--yellow)' : 'var(--text2)';
        lastRunHtml = `${fmtDate(s.lastRunDate)} <span style="color:${hoursColor};font-size:10px">(il y a ${s.hoursSince}h)</span>`;
        if (s.lastRunStatus) {
          lastRunHtml += ' ' + statusTag(s.lastRunStatus);
        }
      }

      const overdueWarning = isOverdue ? `
        <div style="margin-top:10px;padding:8px 12px;background:rgba(239,68,68,0.1);border-radius:6px;border-left:3px solid var(--red);color:var(--red);font-size:11px">
          ⚠ Alerte Telegram envoyée — dernier run il y a ${s.hoursSince}h (seuil : 24h)
        </div>` : '';

      return `
        <div style="background:${bgColor};border:1px solid ${borderColor};border-radius:8px;padding:14px 18px">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
            <div style="flex:1">
              <span style="color:var(--text);font-weight:600;font-size:12px">${s.label}</span>
              <span style="color:var(--text3);font-size:10px;margin-left:8px">${s.type === 'cron' ? '⏱ CRON · ' + (s.cron || '') : '⚙ SERVICE'}</span>
            </div>
            ${statusHtml}
            ${s.memory ? `<span style="color:var(--text3);font-size:10px">${Math.round(s.memory/1024/1024)} MB</span>` : ''}
            ${s.restarts > 0 ? `<span class="tag tag-orange">${s.restarts} restart${s.restarts>1?'s':''}</span>` : ''}
          </div>
          <div style="color:var(--text3);font-size:11px">
            Dernier run : <span style="color:var(--text2)">${lastRunHtml}</span>
          </div>
          ${overdueWarning}
        </div>`;
    }).join('');
    // Trigger overview alerts now that services state is ready
    if (currentView === 'overview') {
      const budW = state.budget?.week?.total_usd || 0;
      showOverviewAlerts(buildAlerts(svcs, budW));
    }
  } catch(e) { console.error('services:', e); }
}

// ── Load /api/system ──────────────────────────────────────────────────────────
async function loadSystem() {
  try {
    const d = await apiFetch('/api/system');
    state.system = d;
    const tb = document.getElementById('system-tbody');
    const procs = d.processes || [];
    tb.innerHTML = procs.length ? procs.map(p => {
      let statusCell;
      if (p.isCron && p.status === 'stopped') {
        const lastRun = p.lastRun ? 'dernier run ' + fmtDate(p.lastRun) : 'jamais exécuté';
        statusCell = `<span class="tag tag-cyan">CRON</span> <span style="color:var(--text3);font-size:10px">${lastRun}</span>`;
      } else {
        statusCell = `<span class="tag ${p.status==='online'?'tag-green':p.status==='errored'?'tag-red':'tag-gray'}">${p.status}</span>`;
      }
      return `<tr>
        <td style="color:var(--text)">${p.name || '—'}</td>
        <td>${statusCell}</td>
        <td>${p.cpu != null ? p.cpu + '%' : '—'}</td>
        <td>${p.memory ? Math.round(p.memory/1024/1024) + ' MB' : '—'}</td>
      </tr>`;
    }).join('') : '<tr><td colspan="4" style="color:var(--text3)">pm2 non disponible</td></tr>';

    // Status global — les crons stopped sont normaux, on ne les compte pas comme down
    const online = procs.filter(p => p.status === 'online').length;
    const crons  = procs.filter(p => p.isCron).length;
    const services = procs.filter(p => !p.isCron);
    const servicesOnline = services.filter(p => p.status === 'online').length;
    const badge = document.getElementById('system-status');
    badge.textContent = servicesOnline + '/' + services.length + ' services · ' + crons + ' crons';
    badge.className = 'tag ' + (servicesOnline === services.length ? 'tag-green' : 'tag-orange');
  } catch(e) { console.error('system:', e); }
}

// ── Load /api/budget ──────────────────────────────────────────────────────────
function fmtEur(v) { return v == null ? '—' : v.toFixed(4) + ' €'; }
function fmtTok(v) { return v == null ? '—' : v >= 1000 ? (v/1000).toFixed(1)+'K' : String(v); }

async function loadBudget() {
  try {
    const d = await apiFetch('/api/budget' + (currentSite ? '?site=' + currentSite : ''));
    state.budget = d;

    const week  = d.week  || {};
    const month = d.month || {};
    const all   = d.all   || {};
    const pct   = d.weekPct || 0;

    // KPIs
    document.getElementById('kpi-budget').textContent      = fmtEur(week.total_eur);
    document.getElementById('budget-week-eur').textContent = fmtEur(week.total_eur);
    document.getElementById('budget-week-usd').textContent = `${(week.total_usd||0).toFixed(4)} $ / 10 $ max`;
    document.getElementById('budget-week-pct').textContent = pct + '% du budget';
    document.getElementById('budget-week-bar').style.width = pct + '%';
    document.getElementById('budget-week-bar').style.background =
      pct > 80 ? 'var(--red)' : pct > 50 ? 'var(--yellow)' : 'var(--green)';

    // Par site
    const bySite = week.by_site || {};
    const lcr = bySite['lcr'] || {};
    const mkd = bySite['mkd'] || {};
    document.getElementById('budget-lcr-eur').textContent = lcr.eur != null ? fmtEur(lcr.eur) : '0.0000 €';
    document.getElementById('budget-lcr-tok').textContent = lcr.tok != null ? fmtTok(lcr.tok) + ' tokens' : '0 tokens';
    document.getElementById('budget-mkd-eur').textContent = mkd.eur != null ? fmtEur(mkd.eur) : '0.0000 €';
    document.getElementById('budget-mkd-tok').textContent = mkd.tok != null ? fmtTok(mkd.tok) + ' tokens' : '0 tokens';

    // Ahrefs — non trackable via API, affichage statique
    document.getElementById('budget-ahrefs-used').textContent = 'N/A';
    document.getElementById('budget-ahrefs-bar').style.width = '0%';

    // Mois / total dans header historique
    document.getElementById('budget-month-eur').textContent = fmtEur(month.total_eur);
    document.getElementById('budget-all-eur').textContent   = fmtEur(all.total_eur);

    // Répartition par module (barres horizontales)
    const byMod = week.by_module || {};
    const totalEurWeek = week.total_eur || 0.0001;
    const modColors = { seo:'var(--green)', content:'var(--cyan)', briefing:'var(--yellow)',
                        crm_sync:'var(--violet)', campaigns:'var(--orange)', indexation:'var(--blue)',
                        seo_agent:'var(--green)' };
    document.getElementById('budget-module-bars').innerHTML =
      Object.keys(byMod).length
      ? Object.entries(byMod).sort((a,b)=>b[1].eur-a[1].eur).map(([mod,v]) => {
          const p = Math.max(1, Math.round(v.eur / totalEurWeek * 100));
          const col = modColors[mod] || 'var(--text3)';
          return `<div style="margin-bottom:10px">
            <div style="display:flex;justify-content:space-between;margin-bottom:3px">
              <span style="color:${col};font-size:10px;letter-spacing:.5px">${mod}</span>
              <span style="color:var(--text3);font-size:9px">${fmtEur(v.eur)} · ${p}%</span>
            </div>
            <div class="progress-wrap" style="height:5px">
              <div class="progress-bar" style="background:${col};width:${p}%"></div>
            </div>
          </div>`;
        }).join('')
      : '<div style="color:var(--text3);font-size:11px;text-align:center;padding:16px">Aucune donnée — les coûts s\'enregistrent à chaque appel API</div>';

    // Top 5
    const top5 = d.top5 || [];
    document.getElementById('budget-top5').innerHTML =
      top5.length ? top5.map(a => `
        <tr>
          <td style="color:var(--text);max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${a.action}">${a.action}</td>
          <td style="color:var(--cyan)">${a.module||'—'}</td>
          <td style="color:var(--text2)">${a.calls}</td>
          <td style="color:var(--yellow);font-weight:600">${fmtEur(a.cost_eur)}</td>
          <td><button onclick="filterAction('${a.action}')" style="background:none;border:1px solid rgba(6,182,212,.3);color:var(--cyan);border-radius:3px;cursor:pointer;font-size:9px;padding:1px 5px;font-family:inherit">VOIR</button></td>
        </tr>`).join('')
      : '<tr><td colspan="5" style="color:var(--text3)">Aucune donnée</td></tr>';

    // Par module table
    document.getElementById('budget-by-module').innerHTML =
      Object.keys(byMod).length ? Object.entries(byMod).sort((a,b)=>b[1].eur-a[1].eur).map(([mod,v]) => `
        <tr>
          <td style="color:var(--cyan)">${mod}</td>
          <td style="color:var(--text2)">${v.calls}</td>
          <td style="color:var(--text3)">${fmtTok(v.tok)}</td>
          <td style="color:var(--yellow);font-weight:600">${fmtEur(v.eur)}</td>
        </tr>`).join('')
      : '<tr><td colspan="4" style="color:var(--text3)">Aucune donnée</td></tr>';

    // Par modèle
    const byMdl = week.by_model || {};
    document.getElementById('budget-by-model').innerHTML =
      Object.keys(byMdl).length ? Object.entries(byMdl).sort((a,b)=>b[1].eur-a[1].eur).map(([mdl,v]) => `
        <tr>
          <td style="color:var(--violet);font-size:10px">${mdl}</td>
          <td style="color:var(--text2)">${v.calls}</td>
          <td style="color:var(--text3)">${fmtTok(v.tok)}</td>
          <td style="color:var(--yellow);font-weight:600">${fmtEur(v.eur)}</td>
        </tr>`).join('')
      : '<tr><td colspan="4" style="color:var(--text3)">Aucune donnée</td></tr>';

    // Historique avec filtre action + bouton delete
    const entries = (all.entries || []).slice().reverse();
    const af = state._budgetActionFilter || '';
    const filtered = af ? entries.filter(e => e.action === af) : entries;
    const filterClearBtn = document.getElementById('budget-filter-clear');
    if (filterClearBtn) filterClearBtn.style.display = af ? '' : 'none';
    document.getElementById('budget-entries-count').textContent = filtered.length + ' entrée' + (filtered.length > 1 ? 's' : '') + (af ? ` · "${af}"` : '');
    document.getElementById('budget-entries-tbody').innerHTML =
      filtered.length ? filtered.map(e => `
        <tr>
          <td class="run-time td-mono">${e.timestamp ? fmtDate(e.timestamp) : e.date||'—'}</td>
          <td style="color:var(--text);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${e.action||''}">${e.action||'—'}</td>
          <td style="color:var(--cyan)">${e.module||'—'}</td>
          <td style="color:var(--text3);font-size:10px">${e.site||'—'}</td>
          <td style="color:var(--violet);font-size:10px">${e.model||'—'}</td>
          <td style="color:var(--text3)">${fmtTok(e.total_tok)}</td>
          <td style="color:var(--yellow);font-weight:600">${fmtEur(e.cost_eur)}</td>
          <td><button onclick="deleteBudgetEntry('${e.timestamp||''}')" title="Supprimer" style="background:none;border:1px solid rgba(239,68,68,.3);color:var(--red);border-radius:3px;cursor:pointer;font-size:10px;padding:1px 6px;line-height:1">×</button></td>
        </tr>`).join('')
      : '<tr><td colspan="8" style="color:var(--text3)">Aucune entrée — les coûts s\'enregistrent à chaque appel API</td></tr>';

  } catch(e) { console.error('budget:', e); }
}

function filterAction(action) {
  state._budgetActionFilter = (state._budgetActionFilter === action) ? '' : action;
  loadBudget();
}

async function deleteBudgetEntry(timestamp) {
  if (!timestamp || !confirm('Supprimer cette entrée de coût ?')) return;
  try {
    await fetch(API + '/api/budget/entry?timestamp=' + encodeURIComponent(timestamp) + '&t=' + Date.now(), { method: 'DELETE' });
    state.budget = null;
    loadBudget();
  } catch(e) { console.error('delete entry:', e); }
}

// ── Notification system ───────────────────────────────────────────────────────
const _dismissedAlerts = new Set();

function showOverviewAlerts(alerts) {
  const container = document.getElementById('overview-alerts');
  if (!container) return;
  const active = alerts.filter(a => !_dismissedAlerts.has(a.id));
  if (!active.length) { container.style.display = 'none'; return; }
  container.style.display = 'flex';
  container.innerHTML = active.map(a => {
    const bg  = a.level === 'error' ? 'rgba(241,68,68,.1)'   : a.level === 'warning' ? 'rgba(250,204,21,.08)' : 'rgba(129,140,249,.08)';
    const brd = a.level === 'error' ? 'rgba(241,68,68,.35)'  : a.level === 'warning' ? 'rgba(250,204,21,.3)'  : 'rgba(129,140,249,.25)';
    const clr = a.level === 'error' ? 'var(--destructive)' : a.level === 'warning' ? 'var(--yellow)' : 'var(--primary)';
    const ico = a.level === 'error' ? '🔴' : a.level === 'warning' ? '🟡' : 'ℹ️';
    return `<div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:${bg};border:1px solid ${brd};border-radius:var(--radius);font-size:12px">
      <span>${ico}</span>
      <span style="color:${clr};font-weight:600">${a.title}</span>
      <span style="color:var(--muted-foreground)">${a.message}</span>
      <button onclick="_dismissedAlerts.add('${a.id}');this.closest('[style]').remove();if(!document.getElementById('overview-alerts').children.length)document.getElementById('overview-alerts').style.display='none'" style="margin-left:auto;background:none;border:none;cursor:pointer;color:var(--muted-foreground);font-size:14px;padding:0 4px">✕</button>
    </div>`;
  }).join('');
}

function buildAlerts(services, budgetWeek) {
  const alerts = [];
  // Agent overdue
  (services || []).filter(s => s.displayStatus === 'overdue').forEach(s => {
    alerts.push({ id: 'overdue-' + s.id, level: 'warning', title: s.label, message: `En retard — ${Math.round(s.hoursSince || 0)}h depuis le dernier run (attendu < 24h)` });
  });
  // pm2 offline
  (services || []).filter(s => s.type === 'service' && !s.pm2Live && s.id !== 'paperclip').forEach(s => {
    alerts.push({ id: 'offline-' + s.id, level: 'error', title: s.label, message: 'Service pm2 hors ligne' });
  });
  // Budget >80%
  if (budgetWeek && budgetWeek > 8) {
    alerts.push({ id: 'budget-hi', level: 'warning', title: 'Budget semaine', message: `$${budgetWeek.toFixed(2)} / $10 max — seuil 80% dépassé` });
  }
  return alerts;
}

// ── Organic Radial Mind Map ───────────────────────────────────────────────────
const MM_NODES = [
  { id: 'genesis',    label: 'Genesis',    icon: '⚙',  color: '#818cf9', r: 0,   angle: 0,   depth: 0 },
  { id: 'anthropic',  label: 'Anthropic',  icon: '🤖',  color: '#c084fc', r: 105, angle: -90, depth: 1 },
  { id: 'ahrefs',     label: 'Ahrefs',     icon: '📊',  color: '#22d3ee', r: 105, angle: -18, depth: 1 },
  { id: 'vps',        label: 'VPS',        icon: '🖥',  color: '#4ade80', r: 105, angle: 54,  depth: 1 },
  { id: 'emelia',     label: 'Emelia',     icon: '📧',  color: '#fb923c', r: 105, angle: 126, depth: 1 },
  { id: 'twenty',     label: 'Twenty CRM', icon: '🗂',  color: '#f472b6', r: 105, angle: 198, depth: 1 },
  { id: 'claude',     label: 'Claude',     icon: '💬',  color: '#a78bfa', r: 185, angle: -110,depth: 2 },
  { id: 'haiku',      label: 'Haiku',      icon: '⚡',  color: '#818cf9', r: 185, angle: -70, depth: 2 },
  { id: 'deepseek',   label: 'DeepSeek',   icon: '🔍',  color: '#93c5fd', r: 185, angle: -30, depth: 2 },
  { id: 'scripts',    label: '.py scripts',icon: '📜',  color: '#86efac', r: 185, angle: 35,  depth: 2 },
  { id: 'memory',     label: 'Memory .md', icon: '🧠',  color: '#fcd34d', r: 185, angle: 75,  depth: 2 },
  { id: 'lcr',        label: 'LCR',        icon: '🔵',  color: '#38bdf8', r: 185, angle: 115, depth: 2 },
  { id: 'mkd',        label: 'MKD',        icon: '🟢',  color: '#34d399', r: 185, angle: 155, depth: 2 },
];

const MM_EDGES = [
  ['genesis','anthropic'],['genesis','ahrefs'],['genesis','vps'],['genesis','emelia'],['genesis','twenty'],
  ['anthropic','claude'],['anthropic','haiku'],['anthropic','deepseek'],
  ['vps','scripts'],['vps','memory'],
  ['genesis','lcr'],['genesis','mkd'],
];

let mmT = 0, mmAnimId = null;

function drawMindMap() {
  const canvas = document.getElementById('mindmap-canvas');
  if (!canvas) return;
  const W = canvas.offsetWidth, H = canvas.offsetHeight;
  canvas.width = W; canvas.height = H;
  const ctx = canvas.getContext('2d');
  const isDark = document.documentElement.classList.contains('dark');
  ctx.clearRect(0, 0, W, H);
  mmT += 0.006;
  const cx = W / 2, cy = H / 2;

  // Compute node positions with gentle organic drift
  const positions = {};
  MM_NODES.forEach(n => {
    if (n.r === 0) { positions[n.id] = { x: cx, y: cy }; return; }
    const drift = Math.sin(mmT + n.angle) * (n.depth === 1 ? 5 : 3);
    const rad = (n.angle + drift * 0.3) * Math.PI / 180;
    positions[n.id] = {
      x: cx + Math.cos(rad) * (n.r + drift),
      y: cy + Math.sin(rad) * (n.r + drift),
    };
  });

  // Draw edges (curved bezier)
  MM_EDGES.forEach(([a, b]) => {
    const pa = positions[a], pb = positions[b];
    if (!pa || !pb) return;
    const mid = { x: (pa.x + pb.x) / 2 + Math.sin(mmT) * 8, y: (pa.y + pb.y) / 2 + Math.cos(mmT) * 8 };
    const pulse = (Math.sin(mmT * 2 + pa.x * 0.01) + 1) / 2;
    ctx.beginPath();
    ctx.moveTo(pa.x, pa.y);
    ctx.quadraticCurveTo(mid.x, mid.y, pb.x, pb.y);
    ctx.strokeStyle = isDark
      ? `rgba(129,140,249,${0.1 + pulse * 0.12})`
      : `rgba(100,104,240,${0.08 + pulse * 0.1})`;
    ctx.lineWidth = 1.2;
    ctx.stroke();
  });

  // Draw nodes
  MM_NODES.forEach(n => {
    const p = positions[n.id];
    if (!p) return;
    const size = n.depth === 0 ? 22 : n.depth === 1 ? 16 : 12;
    const pulse = Math.sin(mmT * 1.5 + n.angle * 0.1);

    // Halo
    const grd = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, size * 2.5);
    grd.addColorStop(0, n.color + '30');
    grd.addColorStop(1, n.color + '00');
    ctx.beginPath();
    ctx.arc(p.x, p.y, size * 2.5 + pulse * 3, 0, Math.PI * 2);
    ctx.fillStyle = grd;
    ctx.fill();

    // Circle
    ctx.beginPath();
    ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
    ctx.fillStyle = isDark ? '#1d293d' : '#ffffff';
    ctx.fill();
    ctx.strokeStyle = n.color;
    ctx.lineWidth = n.depth === 0 ? 2.5 : 1.8;
    ctx.stroke();

    // Icon
    ctx.font = `${n.depth === 0 ? 13 : n.depth === 1 ? 10 : 8}px serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = n.color;
    ctx.fillText(n.icon, p.x, p.y);

    // Label below
    ctx.font = `${n.depth === 0 ? 600 : 500} ${n.depth === 0 ? 10 : 9}px Inter, sans-serif`;
    ctx.textBaseline = 'top';
    ctx.fillStyle = isDark ? 'rgba(227,232,239,0.75)' : 'rgba(29,41,61,0.75)';
    ctx.fillText(n.label, p.x, p.y + size + 4);
  });

  mmAnimId = requestAnimationFrame(drawMindMap);
}

function startMindMap() {
  if (mmAnimId) cancelAnimationFrame(mmAnimId);
  drawMindMap();
}

// ── Load /api/seo ─────────────────────────────────────────────────────────────
async function loadSEO() {
  // Adapter l'affichage selon le site actif
  const colLcr = document.getElementById('seo-col-lcr');
  const colMkd = document.getElementById('seo-col-mkd');
  const wrap   = document.getElementById('seo-cols-wrap');
  if (currentSite === 'lcr') {
    if (colLcr) colLcr.style.display = '';
    if (colMkd) colMkd.style.display = 'none';
    if (wrap)   wrap.style.gridTemplateColumns = '1fr';
  } else if (currentSite === 'mkd') {
    if (colLcr) colLcr.style.display = 'none';
    if (colMkd) colMkd.style.display = '';
    if (wrap)   wrap.style.gridTemplateColumns = '1fr';
  } else {
    if (colLcr) colLcr.style.display = '';
    if (colMkd) colMkd.style.display = '';
    if (wrap)   wrap.style.gridTemplateColumns = '';
  }
  // Titre de la vue
  const hdr = document.querySelector('#view-seo [style*="font-size:13px"]');
  if (hdr) hdr.textContent = 'Analyse SEO — ' + (currentSite ? currentSite.toUpperCase() + ' · Ahrefs' : 'Tous sites · Ahrefs');

  try {
    const d = await apiFetch('/api/seo');
    state.seo = d;

    // Badge configured
    const badge = document.getElementById('seo-config-badge');
    if (d.configured) {
      badge.textContent = 'API OK';
      badge.className = 'tag tag-green';
    } else {
      badge.textContent = 'API non configurée';
      badge.className = 'tag tag-red';
    }

    const nb = document.getElementById('nav-seo-badge'); if (nb) nb.textContent = d.configured ? 'OK' : '!';
    document.getElementById('seo-units-week').textContent = d.unitsWeek || 0;
    document.getElementById('seo-last-sync').textContent = fmtDate(d.checkedAt);

    function renderSitePanel(site, elId, drId, trafficId, compId) {
      const data = (d.sites || {})[site] || {};
      if (data.status === 'no_data' || data.error) {
        document.getElementById(elId).innerHTML =
          `<div style="padding:16px;color:var(--text3);text-align:center">${data.error || 'Aucune donnée'}</div>`;
        document.getElementById(drId).textContent = '—';
        document.getElementById(trafficId).textContent = 'trafic org. —';
        return;
      }

      const metrics  = data.metrics || {};
      const bklinks  = data.backlinks_stats || {};
      const dr       = data.domain_rating?.domain_rating ?? metrics?.organic?.traffic ?? '—';
      const traffic  = metrics?.organic?.traffic ?? '—';
      const refdoms  = bklinks?.referring_domains ?? '—';

      document.getElementById(drId).textContent = typeof dr === 'number' ? Math.round(dr) : dr;
      document.getElementById(trafficId).textContent = `trafic org. ${typeof traffic === 'number' ? traffic.toLocaleString('fr-FR') : '—'}`;

      const topKws = (data.organic_keywords || []).slice(0, 8);
      const kwHtml = topKws.length ? `
        <table style="margin:0">
          <thead><tr><th>MOT-CLÉ</th><th>POS</th><th>VOL</th><th>KD</th></tr></thead>
          <tbody>
            ${topKws.map(kw => `
              <tr>
                <td style="color:var(--text);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                    title="${kw.keyword || ''}">${kw.keyword || '—'}</td>
                <td style="color:${(kw.position||99) <= 3 ? 'var(--green)' : 'var(--text2)'}">${kw.position ?? '—'}</td>
                <td style="color:var(--text3)">${(kw.volume||0).toLocaleString('fr-FR')}</td>
                <td style="color:${(kw.keyword_difficulty||100) < 30 ? 'var(--green)' : 'var(--text2)'}">${kw.keyword_difficulty ?? '—'}</td>
              </tr>`).join('')}
          </tbody>
        </table>
        <div style="padding:6px 0 2px 8px;color:var(--text3);font-size:10px">
          Ref. domains : ${typeof refdoms === 'number' ? refdoms.toLocaleString('fr-FR') : refdoms}
        </div>` : `<div style="padding:12px;color:var(--text3)">Pas de mots-clés</div>`;

      document.getElementById(elId).innerHTML = kwHtml;

      // Concurrents
      const comps = (data.organic_competitors || []).slice(0, 6);
      document.getElementById(compId).innerHTML = comps.length ? comps.map(c => `
        <tr>
          <td style="color:var(--text)">${c.domain || '—'}</td>
          <td style="color:var(--cyan)">${c.domain_rating ?? '—'}</td>
          <td style="color:var(--text2)">${(c.organic_traffic||0).toLocaleString('fr-FR')}</td>
          <td style="color:var(--text3)">${(c.organic_keywords||0).toLocaleString('fr-FR')}</td>
        </tr>`).join('')
        : '<tr><td colspan="4" style="color:var(--text3)">Aucun concurrent trouvé</td></tr>';
    }

    renderSitePanel('lcr', 'seo-lcr-content', 'seo-dr-lcr', 'seo-traffic-lcr', 'seo-comp-lcr');
    renderSitePanel('mkd', 'seo-mkd-content', 'seo-dr-mkd', 'seo-traffic-mkd', 'seo-comp-mkd');
    loadDirectories();

    // Opportunités (KD < 30) des 2 sites
    const allKws = [];
    ['lcr','mkd'].forEach(s => {
      ((d.sites[s] || {}).organic_keywords || []).forEach(kw => {
        if ((kw.keyword_difficulty || 100) < 30) allKws.push({...kw, site: s.toUpperCase()});
      });
    });
    allKws.sort((a,b) => (b.volume||0) - (a.volume||0));
    document.getElementById('seo-opps-count').textContent = allKws.length + ' opportunités';
    document.getElementById('seo-opps-tbody').innerHTML = allKws.length
      ? allKws.slice(0,20).map(kw => `
          <tr>
            <td><span class="tag ${kw.site==='LCR'?'tag-cyan':'tag-green'}">${kw.site}</span></td>
            <td style="color:var(--text)">${kw.keyword}</td>
            <td style="color:var(--text2)">${(kw.volume||0).toLocaleString('fr-FR')}</td>
            <td style="color:var(--green)">${kw.keyword_difficulty}</td>
            <td style="color:var(--text3)">${kw.position ?? '—'}</td>
            <td style="color:var(--yellow)">${(kw.traffic||0).toLocaleString('fr-FR')}</td>
          </tr>`).join('')
      : '<tr><td colspan="6" style="color:var(--text3)">Aucune opportunité — données Ahrefs requises</td></tr>';

  } catch(e) {
    console.error('seo:', e);
  }
}

async function loadDirectories() {
  try {
    const d = await apiFetch('/api/seo/directories');
    const badge = document.getElementById('seo-dirs-badge');
    badge.textContent = `${d.submitted_count}/${d.total} soumis`;
    badge.className   = d.pending_count === 0 ? 'tag tag-green' : 'tag tag-orange';

    const tbody = document.getElementById('seo-dirs-tbody');
    tbody.innerHTML = (d.directories || []).map(dir => `
      <tr id="dir-row-${dir.name.replace(/\s/g,'-')}">
        <td style="color:var(--text);font-weight:${dir.submitted?'400':'600'}">${dir.name}</td>
        <td><span class="tag ${dir.free?'tag-green':'tag-orange'}">${dir.free?'GRATUIT':'PAYANT'}</span></td>
        <td>${dir.submitted
          ? `<span class="tag tag-green">SOUMIS</span> <span style="color:var(--text3);font-size:10px">${(dir.submitted_at||'').slice(0,10)}</span>`
          : `<span class="tag tag-gray">EN ATTENTE</span>`}
        </td>
        <td>${dir.submit_url
          ? `<a href="${dir.submit_url}" target="_blank"
               style="color:var(--cyan);text-decoration:none;font-size:10px"
               onclick="selectDir('${dir.name}')">${dir.submit_url.replace('https://','').slice(0,45)}...</a>`
          : '<span style="color:var(--text3)">Manuel</span>'}
        </td>
      </tr>`).join('');
  } catch(e) { console.error('directories:', e); }
}

let _selectedDir = null;
function selectDir(name) {
  _selectedDir = name;
  document.getElementById('seo-dir-mark-btn').style.display = '';
  document.getElementById('seo-dir-mark-btn').textContent = `MARQUER "${name}" SOUMIS`;
}

async function markDirSubmitted() {
  if (!_selectedDir) return;
  try {
    await fetch(`/api/seo/directories/submit?name=${encodeURIComponent(_selectedDir)}`, {method:'POST'});
    _selectedDir = null;
    document.getElementById('seo-dir-mark-btn').style.display = 'none';
    loadDirectories();
  } catch(e) { console.error(e); }
}

async function triggerSeoRun() {
  const btn = document.getElementById('seo-run-btn');
  btn.textContent = 'EN COURS...';
  btn.disabled = true;
  try {
    const r = await fetch('/api/seo/run?site=both&report=full', {method: 'POST'});
    const d = await r.json();
    if (d.error) {
      btn.textContent = 'ERREUR: ' + d.error;
      btn.style.color = 'var(--red)';
    } else {
      btn.textContent = 'LANCÉ (pid ' + d.pid + ')';
      setTimeout(() => { btn.textContent = 'LANCER ANALYSE'; btn.disabled = false; }, 10000);
      setTimeout(() => loadSEO(), 15000);
    }
  } catch(e) {
    btn.textContent = 'ERREUR';
    btn.style.color = 'var(--red)';
  }
}

// ── Load overview (alerts + per-site budgets + IA table + articles) ──────────
async function loadOverview() {
  // 1. Alerts — build from already-loaded services + budget state (or fetch)
  try {
    const svcs  = (state.services?.services) || [];
    const budW  = state.budget?.week?.total_usd || 0;
    const alerts = buildAlerts(svcs, budW);
    showOverviewAlerts(alerts);
  } catch(e) { console.warn('overview alerts:', e); }

  // 2. Per-site budget KPIs
  try {
    const d = state.budget || await apiFetch('/api/budget');
    const bySite = d.week?.by_site || {};
    const lcr = bySite['lcr'] || {};
    const mkd = bySite['mkd'] || {};
    const lcrUsd = (lcr.usd || 0).toFixed(2);
    const mkdUsd = (mkd.usd || 0).toFixed(2);
    const lcrPct = Math.round((lcr.usd || 0) / 10 * 100);
    const mkdPct = Math.round((mkd.usd || 0) / 10 * 100);

    const elLcr = document.getElementById('kpi-budget-lcr');
    const elMkd = document.getElementById('kpi-budget-mkd');
    const elLcrSub = document.getElementById('kpi-budget-lcr-sub');
    const elMkdSub = document.getElementById('kpi-budget-mkd-sub');
    if (elLcr) { elLcr.textContent = '$' + lcrUsd; elLcr.style.color = lcrPct > 80 ? 'var(--destructive)' : lcrPct > 50 ? 'var(--yellow)' : 'var(--cyan)'; }
    if (elMkd) { elMkd.textContent = '$' + mkdUsd; elMkd.style.color = mkdPct > 80 ? 'var(--destructive)' : mkdPct > 50 ? 'var(--yellow)' : 'var(--green)'; }
    if (elLcrSub) elLcrSub.textContent = lcrPct + '% du budget $10';
    if (elMkdSub) elMkdSub.textContent = mkdPct + '% du budget $10';

    // 3. Budget IA/API table — delegate to renderBudgetIA()
    renderBudgetIA(d);
  } catch(e) { console.warn('overview budget:', e); }

  // 4. Overview articles table (10 cols: SITE, TITRE, STATUT, DATE, COÛT, G, B, Y, VISITEURS, URL)
  try {
    const d = state.articles || await apiFetch('/api/articles');
    const articles = (d.articles || []).filter(x => !x.error);
    const costs = state.budget?.all?.entries || [];
    const idxIcon = `<span style="color:var(--muted-foreground);font-size:10px">—</span>`;
    const tbody = document.getElementById('overview-articles-tbody');
    if (!tbody) return;
    if (!articles.length) {
      tbody.innerHTML = '<tr><td colspan="10" style="color:var(--muted-foreground);padding:12px">Aucun article publié</td></tr>';
      return;
    }
    // Match cost by approximate date + content module
    const contentCosts = costs.filter(e => e.module === 'content');
    tbody.innerHTML = articles.slice(0, 50).map(art => {
      const artDate = (art.date || '').substring(0, 10);
      const matched = contentCosts.find(e => e.date === artDate && e.site === art.site?.toLowerCase());
      const costUsd = matched ? '$' + matched.cost_usd.toFixed(3) : '—';
      const siteTag = art.site === 'LCR' ? 'tag-cyan' : 'tag-green';
      const urlShort = (art.url || '').replace(/^https?:\/\//, '').substring(0, 30);
      return `<tr style="border-top:1px solid var(--border)">
        <td style="padding:6px 8px"><span class="tag ${siteTag}">${art.site || '—'}</span></td>
        <td style="padding:6px 8px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--foreground)" title="${(art.title||'').replace(/"/g,"'")}">
          ${art.title || art.slug || '—'}</td>
        <td style="padding:6px 8px">${statusTag(art.status)}</td>
        <td style="padding:6px 8px;color:var(--muted-foreground);white-space:nowrap">${fmtDate(art.date)}</td>
        <td style="padding:6px 8px;color:var(--yellow);font-size:10px">${costUsd}</td>
        <td style="padding:6px 8px;text-align:center">${idxIcon}</td>
        <td style="padding:6px 8px;text-align:center">${idxIcon}</td>
        <td style="padding:6px 8px;text-align:center">${idxIcon}</td>
        <td style="padding:6px 8px;color:var(--muted-foreground);text-align:center">—</td>
        <td style="padding:6px 8px"><a href="${art.url || '#'}" target="_blank" style="color:var(--primary);text-decoration:none;font-size:11px" title="${art.url || ''}">↗ ${urlShort}</a></td>
      </tr>`;
    }).join('');
  } catch(e) { console.warn('overview articles:', e); }
}

// ── Refresh all ───────────────────────────────────────────────────────────────
async function refreshAll() {
  await loadStatus();
  if (currentView === 'overview')   loadOverview();
  if (currentView === 'campaigns') loadCampaigns();
  if (currentView === 'articles')  loadArticles();
  if (currentView === 'crm')       loadCRM();
  if (currentView === 'services')  loadServices();
  if (currentView === 'system')    loadSystem();
  if (currentView === 'budget')    loadBudget();
  if (currentView === 'runs')      loadRuns();
  if (currentView === 'seo')       loadSEO();
  if (currentView === 'indexation') loadIndexation();
  if (currentView === 'onboarding') loadOnboarding();
  if (currentView === 'analytics')  loadAnalytics();
}

// ── Init ──────────────────────────────────────────────────────────────────────
(async () => {
  startMindMap();
  await loadStatus();
  loadCampaigns();
  loadArticles();
  loadCRM();
  loadServices();
  loadBudget();
  loadOverview();

  applyStoredTheme();
  applySiteColors();
  loadObjectives();
  // Marquer la vue globale active
  document.querySelectorAll(`.nav-item[onclick*="showSiteView('','overview')"]`).forEach(el => el.classList.add('active'));

  // Routing par hash URL
  const validViews = ['overview','campaigns','articles','crm','runs','services','system','budget','seo','site-lcr','site-mkd','indexation','onboarding','analytics'];
  const hash = location.hash.replace('#','');
  if (hash && validViews.includes(hash)) showSiteView('', hash);

  window.addEventListener('hashchange', () => {
    const h = location.hash.replace('#','');
    if (h && validViews.includes(h)) showSiteView('', h);
  });
})();
// ── Indexation ────────────────────────────────────────────────────────────────
async function loadIndexation() {
  const site = document.getElementById('idx-site-select')?.value || 'lcr';
  try {
    const d = await apiFetch('/api/indexation?site=' + site);
    if (d.error) {
      document.getElementById('idx-status-badge').textContent = 'Audit requis';
      document.getElementById('idx-status-badge').className = 'tag tag-red';
    } else {
      document.getElementById('idx-sitemap-count').textContent = d.sitemap_count ?? '—';
      document.getElementById('idx-cms-count').textContent = d.published_count ?? '—';
      document.getElementById('idx-missing-count').textContent = (d.missing_from_sitemap || []).length;
      document.getElementById('idx-broken-count').textContent = (d.http_checks || []).filter(u => !u.ok).length;
      const missing = (d.missing_articles || d.missing_from_sitemap || []);
      const badge = document.getElementById('nav-indexation-badge');
      if (missing.length > 0) {
        if (badge) { badge.textContent = missing.length + ' manquants'; badge.className = 'tag tag-red'; }
        document.getElementById('idx-status-badge').textContent = missing.length + ' articles non indexés';
        document.getElementById('idx-status-badge').className = 'tag tag-red';
      } else {
        if (badge) { badge.textContent = 'OK'; badge.className = 'tag tag-green'; }
        document.getElementById('idx-status-badge').textContent = 'Sitemap complet';
        document.getElementById('idx-status-badge').className = 'tag tag-green';
      }
      const tbody = document.getElementById('idx-missing-tbody');
      if (missing.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" style="color:var(--green);padding:8px">Tous les articles sont dans le sitemap ✓</td></tr>';
      } else {
        tbody.innerHTML = missing.map(a => `
          <tr style="border-top:1px solid rgba(255,255,255,.05)">
            <td style="padding:4px 8px;color:var(--text2)">${(a.title||a.slug||'').substring(0,50)}</td>
            <td style="padding:4px 8px"><a href="${a.url}" target="_blank" style="color:var(--blue);text-decoration:none">${(a.url||'').replace('https://','').substring(0,45)}</a></td>
            <td style="padding:4px 8px;color:var(--text3)">${(a.date||'').substring(0,10)}</td>
          </tr>`).join('');
      }
    }
  } catch(e) {
    document.getElementById('idx-status-badge').textContent = 'Erreur: ' + e.message;
    document.getElementById('idx-status-badge').className = 'tag tag-red';
  }

  // Load daily submission data in parallel
  try {
    const daily = await apiFetch('/api/indexation/daily?site=' + site);
    const r = daily.last_report || {};
    document.getElementById('idx-daily-total').textContent = daily.total_submitted ?? 0;
    document.getElementById('idx-daily-new').textContent = r.new_articles ?? '—';
    document.getElementById('idx-daily-inow').textContent = r.submitted_indexnow ?? '—';
    const dateStr = r.date ? r.date.substring(0,16).replace('T',' ') : '—';
    document.getElementById('idx-daily-date').textContent = dateStr;

    const newUrls = r.new_urls || [];
    if (newUrls.length > 0) {
      document.getElementById('idx-daily-urls').innerHTML =
        '<strong style="color:var(--text2)">Dernières URLs soumises:</strong><br>' +
        newUrls.map(u => `<span style="display:inline-block;margin:2px 4px;padding:2px 6px;background:rgba(59,130,246,.1);border-radius:3px">${u.replace('https://','')}</span>`).join('');
    } else {
      document.getElementById('idx-daily-urls').textContent = daily.total_submitted > 0 ? 'Tous les articles déjà soumis — aucun nouveau ce run.' : 'Aucune soumission enregistrée.';
    }

    const dailyBadge = document.getElementById('idx-daily-badge');
    if (daily.total_submitted > 0) {
      dailyBadge.textContent = daily.total_submitted + ' URLs suivies';
      dailyBadge.className = 'tag tag-green';
    } else {
      dailyBadge.textContent = 'Aucune soumission';
      dailyBadge.className = 'tag tag-gray';
    }
  } catch(e) {
    document.getElementById('idx-daily-badge').textContent = 'Rapport absent';
  }
}

async function triggerDailyIndexation() {
  const site = document.getElementById('idx-site-select')?.value || 'lcr';
  const btn = event.target;
  btn.textContent = 'LANCEMENT...';
  btn.disabled = true;
  try {
    const d = await fetch(API + '/api/indexation/daily/run?site=' + site, {method:'POST'});
    const r = await d.json();
    if (r.started) {
      btn.textContent = 'EN COURS (PID ' + r.pid + ')';
      setTimeout(() => { btn.textContent = 'LANCER MAINTENANT'; btn.disabled = false; loadIndexation(); }, 30000);
    } else {
      btn.textContent = 'ERREUR';
      btn.disabled = false;
    }
  } catch(e) {
    btn.textContent = 'ERREUR';
    btn.disabled = false;
  }
}

async function triggerIndexation() {
  const site = document.getElementById('idx-site-select')?.value || 'lcr';
  const btn = event.target;
  btn.textContent = 'LANCEMENT...';
  btn.disabled = true;
  try {
    const d = await fetch(API + '/api/indexation/run?site=' + site + '&task=all', {method:'POST'});
    const r = await d.json();
    if (r.started) {
      btn.textContent = 'EN COURS (PID ' + r.pid + ')';
      setTimeout(() => { btn.textContent = 'LANCER AUDIT'; btn.disabled = false; loadIndexation(); }, 30000);
    } else {
      btn.textContent = 'ERREUR';
      btn.disabled = false;
    }
  } catch(e) {
    btn.textContent = 'ERREUR';
    btn.disabled = false;
  }
}

// ── Wizard Onboarding ─────────────────────────────────────────────────────────
let wizardStep = 1;
let wizardSavedCode = null;
let wizardCMS = 'emdash';

function selectCMS(cms) {
  wizardCMS = cms;
  document.querySelectorAll('.cms-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('cms-' + cms).classList.add('selected');
  document.getElementById('cms-emdash-fields').style.display = cms === 'emdash' ? '' : 'none';
  document.getElementById('cms-wp-fields').style.display = cms === 'wordpress' ? '' : 'none';
}

function wizardGoTo(step) {
  // Only allow going back or to completed steps
  if (step >= wizardStep && step !== wizardStep) return;
  wizardStep = step;
  renderWizardStep();
}

function wizardNext() {
  if (!wizardValidateStep(wizardStep)) return;
  if (wizardStep < 5) {
    wizardStep++;
    renderWizardStep();
  }
}

function wizardPrev() {
  if (wizardStep > 1) { wizardStep--; renderWizardStep(); }
}

function wizardValidateStep(step) {
  if (step === 1) {
    const code = document.getElementById('w-code').value.trim();
    const label = document.getElementById('w-label').value.trim();
    const domain = document.getElementById('w-domain').value.trim();
    if (!code || !label || !domain) {
      alert('Veuillez remplir le code, le nom et le domaine.');
      return false;
    }
    if (!/^[a-z][a-z0-9]{1,15}$/.test(code)) {
      alert('Code invalide: 2-16 caractères alphanumériques minuscules.');
      return false;
    }
  }
  if (step === 3) {
    const kws = document.getElementById('w-keywords').value.trim().split('\n').filter(k => k.trim());
    if (kws.length < 1) {
      alert('Ajoutez au moins 1 mot-clé.');
      return false;
    }
  }
  return true;
}

function renderWizardStep() {
  for (let i = 1; i <= 5; i++) {
    document.getElementById('wstep-' + i).style.display = i === wizardStep ? '' : 'none';
    const dot = document.getElementById('wdot-' + i);
    dot.className = 'wizard-step-dot' + (i === wizardStep ? ' active' : i < wizardStep ? ' done' : '');
  }
  document.getElementById('wizard-status-badge').textContent = 'Étape ' + wizardStep + '/5';
  document.getElementById('wizard-prev-btn').style.display = wizardStep > 1 ? '' : 'none';
  document.getElementById('wizard-next-btn').style.display = wizardStep < 5 ? '' : 'none';
  document.getElementById('wizard-save-btn').style.display = wizardStep === 5 ? '' : 'none';
  if (wizardStep === 5) updateRAGPreview();
}

function addRssRow() {
  const row = document.createElement('div');
  row.className = 'rss-row';
  row.innerHTML = '<input type="text" placeholder="Nom source" style="max-width:160px"/><input type="text" placeholder="URL flux RSS"/><button onclick="removeRssRow(this)" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:var(--red);border-radius:4px;padding:4px 8px;cursor:pointer;font-size:11px;font-family:inherit">✕</button>';
  document.getElementById('rss-rows').appendChild(row);
}

function removeRssRow(btn) {
  btn.parentElement.remove();
}

function updateRAGPreview() {
  const code = document.getElementById('w-code').value || 'site';
  const label = document.getElementById('w-label').value || 'Mon Site';
  const domain = document.getElementById('w-domain').value || 'monsite.com';
  const url = document.getElementById('w-url').value || 'https://monsite.com';
  const industry = document.getElementById('w-industry').value || '';
  const audience = document.getElementById('w-audience').value || '';
  const bizDesc = document.getElementById('w-biz-desc').value || '';
  const valueProp = document.getElementById('w-value-prop').value || '';
  const products = document.getElementById('w-products').value.split('\n').filter(l=>l.trim()).map(l=>'- '+l).join('\n');
  const competitors = document.getElementById('w-competitors').value.split('\n').filter(l=>l.trim()).map(l=>'- '+l).join('\n');
  const tov = document.getElementById('w-tone-of-voice').value || '';
  const tone = document.getElementById('w-tone').value || '';
  const cta = document.getElementById('w-cta').value || '';
  const seoGoals = document.getElementById('w-seo-goals').value || '';
  const keywords = document.getElementById('w-keywords').value.split('\n').filter(k=>k.trim()).join(', ');
  const today = new Date().toISOString().slice(0,10);
  const preview = `# Contexte site — ${label} (${code})\n> Généré le ${today}\n\n## Identité\n- Domaine : ${domain} | URL : ${url}\n- Secteur : ${industry}\n\n## Description de l'activité\n${bizDesc}\n\n## Audience principale\n${audience}\n\n## Proposition de valeur\n${valueProp}\n\n## Produits et services\n${products}\n\n## Ton éditorial\n${tov}\n- Ton : ${tone}\n- CTA : "${cta}"\n\n## Objectifs SEO\n${seoGoals}\nMots-clés : ${keywords}\n\n## Concurrents\n${competitors}`;
  document.getElementById('rag-preview').textContent = preview;
}

function collectWizardData() {
  const rssRows = document.querySelectorAll('#rss-rows .rss-row');
  const rssSources = [];
  rssRows.forEach(row => {
    const inputs = row.querySelectorAll('input');
    if (inputs[0].value && inputs[1].value)
      rssSources.push({name: inputs[0].value, url: inputs[1].value});
  });
  return {
    code:     document.getElementById('w-code').value.trim(),
    label:    document.getElementById('w-label').value.trim(),
    domain:   document.getElementById('w-domain').value.trim(),
    url:      document.getElementById('w-url').value.trim(),
    country:  document.getElementById('w-country').value,
    language: document.getElementById('w-language').value,
    primary_color: document.getElementById('w-color').value,
    cms:      wizardCMS,
    blog_url: document.getElementById('w-blog-url').value.trim(),
    tone:     document.getElementById('w-tone').value.trim(),
    cta:      document.getElementById('w-cta').value.trim(),
    keywords: document.getElementById('w-keywords').value.split('\n').filter(k=>k.trim()),
    sitemap_url: document.getElementById('w-sitemap').value.trim(),
    blog_prefix: document.getElementById('w-blog-prefix').value.trim(),
    rss_sources: rssSources,
    is_directory_target: document.getElementById('w-dir-target').checked,
    from_name:    document.getElementById('w-from-name').value.trim(),
    from_email:   document.getElementById('w-from-email').value.trim(),
    subject_tpl:  document.getElementById('w-subject-tpl').value.trim(),
    topics:       document.getElementById('w-topics').value.split('\n').filter(t=>t.trim()),
    cta_url:      document.getElementById('w-nl-cta-url').value.trim(),
    cta_label:    document.getElementById('w-nl-cta-label').value.trim(),
    footer_desc:  document.getElementById('w-footer-desc').value.trim(),
    business_description: document.getElementById('w-biz-desc').value.trim(),
    primary_audience:     document.getElementById('w-audience').value.trim(),
    industry:             document.getElementById('w-industry').value.trim(),
    value_proposition:    document.getElementById('w-value-prop').value.trim(),
    competitors:          document.getElementById('w-competitors').value.split('\n').filter(c=>c.trim()),
    tone_of_voice:        document.getElementById('w-tone-of-voice').value.trim(),
    seo_goals:            document.getElementById('w-seo-goals').value.trim(),
    products_services:    document.getElementById('w-products').value.split('\n').filter(p=>p.trim()),
    emdash_token: document.getElementById('w-emdash-token').value,
    emdash_url:   document.getElementById('w-emdash-url').value,
    wp_url:       document.getElementById('w-wp-url').value,
    wp_username:  document.getElementById('w-wp-user').value,
    wp_app_password: document.getElementById('w-wp-pass').value,
  };
}

async function wizardSave() {
  if (!wizardValidateStep(5)) return;
  const btn = document.getElementById('wizard-save-btn');
  btn.textContent = 'ENREGISTREMENT...';
  btn.disabled = true;
  try {
    const data = collectWizardData();
    const r = await fetch(API + '/api/sites', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(data),
    });
    const result = await r.json();
    if (result.ok) {
      wizardSavedCode = result.code;
      showWizardConfirm(result, data);
    } else {
      alert('Erreur: ' + (result.error || 'inconnue'));
      btn.textContent = 'ENREGISTRER LE SITE';
      btn.disabled = false;
    }
  } catch(e) {
    alert('Erreur réseau: ' + e.message);
    btn.textContent = 'ENREGISTRER LE SITE';
    btn.disabled = false;
  }
}

function showWizardConfirm(result, data) {
  document.getElementById('wizard-save-btn').style.display = 'none';
  document.getElementById('wizard-next-btn').style.display = 'none';
  document.getElementById('wizard-prev-btn').style.display = 'none';
  document.getElementById('wizard-confirm-panel').style.display = '';
  document.getElementById('wizard-confirm-summary').innerHTML = `
    <strong style="color:var(--text1)">${data.label}</strong> (${data.code}) enregistré<br>
    Domaine : ${data.domain} | CMS : ${data.cms}<br>
    Keywords : ${data.keywords.length} mots-clés | RSS : ${data.rss_sources.length} sources<br>
    Dossier : <code style="font-size:10px">${result.memory_dir || 'memory/'+data.code+'/'}</code><br>
    <br>
    <strong>Actions à effectuer :</strong><br>
    ✓ Config enregistrée dans sites-config.json<br>
    ✓ Dossier memory/${data.code}/ créé<br>
    ✓ Chunk RAG (site-context.md) généré<br>
    ○ SEO audit Ahrefs (lors de l'onboarding live)<br>
    ○ Indexation audit (lors de l'onboarding live)<br>
    ○ 4 crons pm2 (lors de l'onboarding live)
  `;
  loadOnboarding(); // refresh sites list
}

async function launchOnboarding(live) {
  if (!wizardSavedCode) return;
  const resultDiv = document.getElementById('wizard-onboard-result');
  resultDiv.textContent = live ? 'Lancement onboarding LIVE...' : 'Lancement dry-run...';
  try {
    const r = await fetch(API + '/api/sites/' + wizardSavedCode + '/onboard?dry_run=' + (!live), {method:'POST'});
    const d = await r.json();
    if (d.started) {
      resultDiv.innerHTML = `<span style="color:var(--green)">✓ Onboarding lancé (PID ${d.pid})${live ? ' — live' : ' — dry-run'}</span><br><small style="color:var(--text3)">Consultez pm2 logs genesis-dashboard pour le suivi</small>`;
    } else {
      resultDiv.innerHTML = `<span style="color:var(--red)">✗ Erreur: ${d.error || 'inconnue'}</span>`;
    }
  } catch(e) {
    resultDiv.textContent = 'Erreur: ' + e.message;
  }
}

async function testCMSConnection() {
  const resultEl = document.getElementById('cms-test-result');
  resultEl.textContent = 'Test en cours...';
  const payload = {
    cms: wizardCMS,
    emdash_url:   document.getElementById('w-emdash-url').value,
    emdash_token: document.getElementById('w-emdash-token').value,
    wp_url:       document.getElementById('w-wp-url').value,
    wp_username:  document.getElementById('w-wp-user').value,
    wp_app_password: document.getElementById('w-wp-pass').value,
  };
  try {
    const r = await fetch(API + '/api/sites/test-cms', {
      method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload),
    });
    const d = await r.json();
    resultEl.innerHTML = d.ok
      ? '<span style="color:var(--green)">✓ Connexion OK (HTTP ' + d.status_code + ')</span>'
      : '<span style="color:var(--red)">✗ Erreur (HTTP ' + (d.status_code||'?') + ') ' + (d.error||'') + '</span>';
  } catch(e) {
    resultEl.innerHTML = '<span style="color:var(--red)">✗ ' + e.message + '</span>';
  }
}

function resetWizard() {
  wizardStep = 1;
  wizardSavedCode = null;
  document.getElementById('wizard-confirm-panel').style.display = 'none';
  document.getElementById('wizard-save-btn').style.display = '';
  ['w-code','w-label','w-domain','w-url','w-tone','w-cta','w-keywords',
   'w-sitemap','w-blog-prefix','w-from-name','w-from-email','w-topics',
   'w-nl-cta-url','w-nl-cta-label','w-footer-desc','w-biz-desc',
   'w-audience','w-industry','w-value-prop','w-competitors','w-products',
   'w-seo-goals','w-tone-of-voice'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  renderWizardStep();
}

async function loadOnboarding() {
  // Load registered sites list
  try {
    const d = await apiFetch('/api/sites');
    const sites = Object.values(d.sites || {});
    const badge = document.getElementById('nav-onboarding-badge');
    if (badge) { badge.textContent = sites.length + ' sites'; badge.className = 'tag tag-orange'; }
    const panel = document.getElementById('wizard-registered-sites');
    const table = document.getElementById('wizard-sites-table');
    if (sites.length > 0 && panel && table) {
      panel.style.display = '';
      table.innerHTML = `<table style="width:100%;border-collapse:collapse;font-size:11px">
        <thead><tr style="color:var(--text3)"><th style="padding:4px 8px;text-align:left">Code</th><th style="padding:4px 8px;text-align:left">Site</th><th style="padding:4px 8px;text-align:left">Domaine</th><th style="padding:4px 8px;text-align:left">CMS</th><th style="padding:4px 8px;text-align:left">Statut</th></tr></thead>
        <tbody>${sites.map(s => {
          const core = s.core || {};
          const meta = s._meta || {};
          const status = meta.status || '?';
          const statusColor = status === 'active' ? 'var(--green)' : status === 'onboarding' ? '#f97316' : 'var(--text3)';
          return `<tr style="border-top:1px solid rgba(255,255,255,.05)">
            <td style="padding:4px 8px;font-family:monospace;color:var(--text3)">${core.code||'?'}</td>
            <td style="padding:4px 8px;color:var(--text1)">${core.label||'?'}</td>
            <td style="padding:4px 8px"><a href="${core.url||'#'}" target="_blank" style="color:var(--blue);text-decoration:none">${core.domain||'?'}</a></td>
            <td style="padding:4px 8px;color:var(--text2)">${(s.content||{}).cms||'?'}</td>
            <td style="padding:4px 8px;color:${statusColor}">${status}</td>
          </tr>`;
        }).join('')}</tbody>
      </table>`;
    }
  } catch(e) {
    console.warn('loadOnboarding error:', e);
  }
}

// ── Analytics (style Foudroyer) ───────────────────────────────────────────────
async function loadAnalytics() {
  const site = currentSite || document.getElementById('analytics-site-select')?.value || 'lcr';
  // Sync le select visuel si existant
  const sel = document.getElementById('analytics-site-select');
  if (sel && currentSite) sel.value = currentSite;
  const badge = document.getElementById('analytics-sync-badge');
  if (badge) { badge.textContent = 'chargement...'; badge.className = 'tag tag-gray'; }

  try {
    const d = await apiFetch('/api/analytics?site=' + site);

    // Badge
    const score = d.health_score ?? 0;
    const scoreColor = score >= 60 ? 'tag-green' : score >= 30 ? 'tag-yellow' : 'tag-red';
    if (badge) { badge.textContent = 'Score ' + score + '/100 · ' + (d.date||''); badge.className = 'tag ' + scoreColor; }
    const ab = document.getElementById('nav-analytics-badge');
    if (ab) { ab.textContent = score + '/100'; ab.className = 'tag ' + scoreColor; }

    // Score circle
    const circle = document.getElementById('analytics-score-circle');
    const circleColor = score >= 60 ? 'var(--green)' : score >= 30 ? 'var(--yellow)' : 'var(--red)';
    circle.textContent = score;
    circle.style.borderColor = circleColor;
    circle.style.color = circleColor;
    document.getElementById('analytics-score-label').textContent = 'sur 100';

    // Score breakdown
    const bd = d.score_breakdown || {};
    document.getElementById('analytics-score-breakdown').innerHTML = [
      ['Domain Rating', bd.domain_rating, 40],
      ['Indexation', bd.indexation, 30],
      ['Keywords', bd.keywords, 20],
      ['Trafic', bd.traffic, 10],
    ].map(([label, val, max]) => {
      const pct = Math.round((val||0) / max * 100);
      return `<div style="display:flex;align-items:center;gap:6px;font-size:9px">
        <span style="width:70px;text-align:right;color:var(--text3)">${label}</span>
        <div style="flex:1;height:4px;background:rgba(255,255,255,.08);border-radius:2px">
          <div style="width:${pct}%;height:100%;background:${circleColor};border-radius:2px"></div>
        </div>
        <span style="color:var(--text3)">${(val||0).toFixed(1)}/${max}</span>
      </div>`;
    }).join('');

    // KPIs
    const k = d.kpis || {};
    document.getElementById('a-dr').textContent = k.domain_rating ?? '—';
    document.getElementById('a-traffic').textContent = (k.organic_traffic ?? '—').toLocaleString();
    document.getElementById('a-kw').textContent = k.org_keywords ?? '—';
    document.getElementById('a-published').textContent = k.articles_published ?? '—';
    document.getElementById('a-indexed').textContent = k.articles_indexed ?? '—';
    document.getElementById('a-missing').textContent = k.articles_missing ?? '—';

    // Alerts
    const alerts = d.alerts || [];
    document.getElementById('analytics-alerts').innerHTML = alerts.length === 0
      ? ''
      : alerts.map(a => {
          const c = a.level === 'critique' ? 'var(--red)' : a.level === 'important' ? 'var(--yellow)' : 'var(--text3)';
          const icon = a.level === 'critique' ? '⛔' : a.level === 'important' ? '⚠' : 'ℹ';
          return `<div style="padding:8px 12px;margin-bottom:6px;border-radius:6px;border:1px solid ${c};background:${c.replace(')',', .08)')};font-size:11px;color:var(--text1)">
            <span style="margin-right:6px">${icon}</span>
            <strong style="color:${c};text-transform:uppercase;font-size:9px;letter-spacing:.5px">${a.level}</strong>
            <span style="margin-left:8px">${a.msg}</span>
          </div>`;
        }).join('');

    // Keywords ranking
    const kws = d.keywords || [];
    document.getElementById('analytics-kw-tbody').innerHTML = kws.length === 0
      ? '<tr><td colspan="4" style="color:var(--text3);padding:8px">Aucun keyword ranké (DR trop bas)</td></tr>'
      : kws.map(kw => {
          const pos = kw.best_position;
          const posColor = pos <= 3 ? 'var(--green)' : pos <= 10 ? 'var(--yellow)' : 'var(--text3)';
          return `<tr style="border-top:1px solid rgba(255,255,255,.04)">
            <td style="padding:4px 6px;color:var(--text2)">${kw.keyword}</td>
            <td style="padding:4px 6px;text-align:center;font-weight:700;color:${posColor}">#${pos}</td>
            <td style="padding:4px 6px;text-align:right;color:var(--text3)">${(kw.volume||0).toLocaleString()}</td>
            <td style="padding:4px 6px;text-align:center;color:var(--text3)">${kw.keyword_difficulty??'—'}</td>
          </tr>`;
        }).join('');

    // Opportunities
    const opps = d.opportunities || [];
    document.getElementById('analytics-opps-tbody').innerHTML = opps.length === 0
      ? '<tr><td colspan="3" style="color:var(--green);padding:8px">Aucune opportunité détectée (ou SEO brief non généré)</td></tr>'
      : opps.map(op => `<tr style="border-top:1px solid rgba(255,255,255,.04)">
          <td style="padding:4px 6px;color:var(--yellow)">${op.keyword}</td>
          <td style="padding:4px 6px;text-align:right;color:var(--text3)">${(op.volume||0).toLocaleString()}</td>
          <td style="padding:4px 6px;text-align:center;color:var(--green)">${op.difficulty}</td>
        </tr>`).join('');

    // KW Overview (targeted keywords SERP)
    const kwo = d.kw_overview || [];
    document.getElementById('analytics-kw-overview-tbody').innerHTML = kwo.length === 0 ? '<tr><td colspan="4" style="color:var(--text3)">—</td></tr>' :
      kwo.map(kw => `<tr style="border-top:1px solid rgba(255,255,255,.04)">
        <td style="padding:4px 6px;color:var(--text2)">${kw.keyword}</td>
        <td style="padding:4px 6px;text-align:right;color:var(--text3)">${(kw.volume||0).toLocaleString()}</td>
        <td style="padding:4px 6px;text-align:center;color:var(--yellow)">${kw.difficulty??'—'}</td>
        <td style="padding:4px 6px;text-align:center;color:var(--text3)">${kw.cpc ? kw.cpc+'¢' : '—'}</td>
      </tr>`).join('');

    // Top pages
    const pages = d.top_pages || [];
    document.getElementById('analytics-top-pages').innerHTML = pages.length === 0
      ? '<div style="color:var(--text3);font-size:11px">Aucune donnée</div>'
      : pages.map(p => {
          const url = p.url || '';
          const short = url.replace(/^https?:\/\/[^/]+/, '').substring(0, 45) || '/';
          return `<div style="padding:5px 0;border-top:1px solid rgba(255,255,255,.05);font-size:11px">
            <a href="${url}" target="_blank" style="color:var(--blue);text-decoration:none">${short}</a>
            <span style="float:right;color:var(--text3)">#${p.top_keyword_best_position||'?'} · ${p.keywords||0} kw</span>
          </div>`;
        }).join('');

    // Competitors
    const comps = d.competitors || [];
    document.getElementById('analytics-comp-tbody').innerHTML = comps.length === 0
      ? '<tr><td colspan="3" style="color:var(--text3);padding:8px">Aucun concurrent détecté</td></tr>'
      : comps.map(c => {
          const drColor = c.domain_rating >= 50 ? 'var(--red)' : c.domain_rating >= 20 ? 'var(--yellow)' : 'var(--text3)';
          return `<tr style="border-top:1px solid rgba(255,255,255,.04)">
            <td style="padding:4px 6px"><a href="https://${c.competitor_domain}" target="_blank" style="color:var(--blue);text-decoration:none">${c.competitor_domain}</a></td>
            <td style="padding:4px 6px;text-align:center;color:${drColor};font-weight:700">${c.domain_rating}</td>
            <td style="padding:4px 6px;text-align:right;color:var(--text3)">${(c.traffic||0).toLocaleString()}</td>
          </tr>`;
        }).join('');

    // SERP top
    const serp = d.serp_top || [];
    document.getElementById('analytics-serp-top').innerHTML = serp.length === 0
      ? '<div style="color:var(--text3);font-size:11px">Données SERP non disponibles</div>'
      : `<div style="font-size:10px;color:var(--text3);margin-bottom:8px">Analyse basée sur vos mots-clés cibles</div>` +
        serp.map((s, i) => {
          const drColor = s.domain_rating >= 50 ? 'var(--red)' : s.domain_rating >= 20 ? 'var(--yellow)' : 'var(--green)';
          return `<div style="display:flex;align-items:center;gap:10px;padding:5px 0;border-top:1px solid rgba(255,255,255,.05);font-size:11px">
            <span style="font-weight:700;color:var(--text3);min-width:20px">#${i+1}</span>
            <div style="flex:1;min-width:0">
              <a href="${s.url}" target="_blank" style="color:var(--blue);text-decoration:none;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${s.title||s.url}</a>
              <span style="font-size:9px;color:var(--text3)">${(s.url||'').replace(/^https?:\/\//, '').substring(0,50)}</span>
            </div>
            <span class="tag" style="color:${drColor};border-color:${drColor};background:${drColor.replace(')',', .1)')};font-size:9px">DR ${s.domain_rating||'?'}</span>
            <span style="color:var(--text3);font-size:10px;white-space:nowrap">${(s.traffic||0).toLocaleString()} vis.</span>
          </div>`;
        }).join('');

    // Missing articles panel
    const missing = d.missing_articles || [];
    const missingPanel = document.getElementById('analytics-missing-panel');
    if (missing.length > 0 && missingPanel) {
      missingPanel.style.display = '';
      document.getElementById('analytics-missing-badge').textContent = missing.length;
      document.getElementById('analytics-missing-list').innerHTML =
        missing.map(a => `<a href="${a.url}" target="_blank" style="color:var(--blue);text-decoration:none;display:block">↗ ${a.title||a.slug}</a>`).join('');
    }

  } catch(e) {
    if (badge) { badge.textContent = 'Erreur: ' + e.message; badge.className = 'tag tag-red'; }
  }
}

</script>
</body>
</html>
